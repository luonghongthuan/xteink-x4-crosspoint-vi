+#pragma once
+
+#include <Rtc.h>
+
+#include "activities/Activity.h"
+#include "util/ButtonNavigator.h"
+
+class GfxRenderer;
+
+// Month-grid calendar with the Vietnamese lunar date (âm lịch) for the selected day.
+//
+// Resource note (AGENTS.md): no heap. The grid is recomputed from the selected
+// y/m/d on every render into stack locals, and only the SELECTED day is converted
+// to lunar — the ESP32-C3 has no FPU, so the trig in the conversion runs in
+// software float and converting all 42 cells would cost ~40x more for information
+// the screen has no room to show anyway.
+//
+// The date comes from HalClock::getLocalDateTime(), which on the plain X4 is
+// backed by the software clock (that board has no RTC chip). When no clock is
+// available the screen still opens, starting at a fixed epoch, and says so.
+class CalendarActivity final : public Activity {
+ public:
+  CalendarActivity(GfxRenderer& renderer, MappedInputManager& mappedInput);
+
+  void onEnter() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+
+ private:
+  ButtonNavigator buttonNavigator;
+
+  int selYear = 2026;
+  int selMonth = 1;
+  int selDay = 1;
+
+  int todayYear = 0;  // 0 = clock unavailable
+  int todayMonth = 0;
+  int todayDay = 0;
+
+  void loadToday();
+  void jumpToToday();
+  void shiftDays(int delta);  // move the selection, carrying across months/years
+};
diff --git a/src/util/LunarCalendar.cpp b/src/util/LunarCalendar.cpp
new file mode 100644
index 0000000..e02fc7b
--- /dev/null
+++ b/src/util/LunarCalendar.cpp
@@ -0,0 +1,180 @@
+#include "LunarCalendar.h"
+
+#include <cmath>
+
+namespace lunar {
+namespace {
+
+constexpr double PI_ = 3.14159265358979323846;
+// Mean synodic month (days) and the Julian day of new moon k=0, per Meeus.
+constexpr double SYNODIC_MONTH = 29.530588853;
+constexpr double NEW_MOON_EPOCH = 2415021.076998695;
+
+inline int32_t iFloor(double d) { return static_cast<int32_t>(std::floor(d)); }
+
+// Julian day of the k-th new moon since 1900-01-01, from Meeus' "Astronomical
+// Algorithms" ch. 49 (the truncated series Hồ Ngọc Đức's reference uses).
+double newMoon(int32_t k) {
+  const double T = static_cast<double>(k) / 1236.85;
+  const double T2 = T * T;
+  const double T3 = T2 * T;
+  const double dr = PI_ / 180.0;
+
+  double jd1 = 2415020.75933 + 29.53058868 * k + 0.0001178 * T2 - 0.000000155 * T3;
+  jd1 += 0.00033 * std::sin((166.56 + 132.87 * T - 0.009173 * T2) * dr);
+
+  const double M = 359.2242 + 29.10535608 * k - 0.0000333 * T2 - 0.00000347 * T3;     // sun's mean anomaly
+  const double Mpr = 306.0253 + 385.81691806 * k + 0.0107306 * T2 + 0.00001236 * T3;  // moon's mean anomaly
+  const double F = 21.2964 + 390.67050646 * k - 0.0016528 * T2 - 0.00000239 * T3;     // moon's argument of latitude
+
+  double c1 = (0.1734 - 0.000393 * T) * std::sin(M * dr) + 0.0021 * std::sin(2 * dr * M);
+  c1 -= 0.4068 * std::sin(Mpr * dr);
+  c1 += 0.0161 * std::sin(dr * 2 * Mpr);
+  c1 -= 0.0004 * std::sin(dr * 3 * Mpr);
+  c1 += 0.0104 * std::sin(dr * 2 * F);
+  c1 -= 0.0051 * std::sin(dr * (M + Mpr));
+  c1 -= 0.0074 * std::sin(dr * (M - Mpr));
+  c1 += 0.0004 * std::sin(dr * (2 * F + M));
+  c1 -= 0.0004 * std::sin(dr * (2 * F - M));
+  c1 -= 0.0006 * std::sin(dr * (2 * F + Mpr));
+  c1 += 0.0010 * std::sin(dr * (2 * F - Mpr));
+  c1 += 0.0005 * std::sin(dr * (2 * Mpr + M));
+
+  double deltat;
+  if (T < -11.0) {
+    deltat = 0.001 + 0.000839 * T + 0.0002261 * T2 - 0.00000845 * T3 - 0.000000081 * T * T3;
+  } else {
+    deltat = -0.000278 + 0.000265 * T + 0.000262 * T2;
+  }
+  return jd1 + c1 - deltat;
+}
+
+// Apparent longitude of the sun, in radians, at Julian day `jdn` (TT).
+double sunLongitude(double jdn) {
+  const double T = (jdn - 2451545.0) / 36525.0;
+  const double T2 = T * T;
+  const double dr = PI_ / 180.0;
+
+  const double M = 357.52910 + 35999.05030 * T - 0.0001559 * T2 - 0.00000048 * T * T2;
+  const double L0 = 280.46645 + 36000.76983 * T + 0.0003032 * T2;
+
+  double dl = (1.914600 - 0.004817 * T - 0.000014 * T2) * std::sin(dr * M);
+  dl += (0.019993 - 0.000101 * T) * std::sin(dr * 2 * M);
+  dl += 0.000290 * std::sin(dr * 3 * M);
+
+  double l = (L0 + dl) * dr;
+  l -= PI_ * 2.0 * static_cast<double>(iFloor(l / (PI_ * 2.0)));  // normalise to [0, 2pi)
+  return l;
+}
+
+// Solar term index 0..11 (each 30 degrees) for the local day `dayNumber`.
+int sunLongitudeIndex(int32_t dayNumber, double timeZone) {
+  return static_cast<int>(iFloor(sunLongitude(dayNumber - 0.5 - timeZone / 24.0) / PI_ * 6.0));
+}
+
+// Local day on which the k-th new moon falls.
+int32_t newMoonDay(int32_t k, double timeZone) { return iFloor(newMoon(k) + 0.5 + timeZone / 24.0); }
+
+// Local day the 11th lunar month of `year` begins (the month containing the winter solstice).
+int32_t lunarMonth11(int year, double timeZone) {
+  const double off = static_cast<double>(jdFromDate(31, 12, year)) - 2415021.0;
+  int32_t k = iFloor(off / SYNODIC_MONTH);
+  int32_t nm = newMoonDay(k, timeZone);
+  if (sunLongitudeIndex(nm, timeZone) >= 9) nm = newMoonDay(k - 1, timeZone);
+  return nm;
+}
+
+// Index (from month 11) of the leap month in a 13-month lunar year.
+int leapMonthOffset(int32_t a11, double timeZone) {
+  const int32_t k = iFloor((a11 - NEW_MOON_EPOCH) / SYNODIC_MONTH + 0.5);
+  int i = 1;
+  int last = 0;
+  int arc = sunLongitudeIndex(newMoonDay(k + i, timeZone), timeZone);
+  do {
+    last = arc;
+    i++;
+    arc = sunLongitudeIndex(newMoonDay(k + i, timeZone), timeZone);
+  } while (arc != last && i < 14);
+  return i - 1;
+}
+
+}  // namespace
+
+int32_t jdFromDate(int day, int month, int year) {
+  const int32_t a = (14 - month) / 12;
+  const int32_t y = year + 4800 - a;
+  const int32_t m = month + 12 * a - 3;
+  int32_t jd = day + (153 * m + 2) / 5 + 365 * y + y / 4 - y / 100 + y / 400 - 32045;
+  if (jd < 2299161) {  // before the Gregorian cutover: fall back to the Julian calendar
+    jd = day + (153 * m + 2) / 5 + 365 * y + y / 4 - 32083;
+  }
+  return jd;
+}
+
+void jdToDate(int32_t jd, int& day, int& month, int& year) {
+  int32_t a, b, c;
+  if (jd > 2299160) {  // Gregorian
+    a = jd + 32044;
+    b = (4 * a + 3) / 146097;
+    c = a - (b * 146097) / 4;
+  } else {  // Julian
+    b = 0;
+    c = jd + 32082;
+  }
+  const int32_t d = (4 * c + 3) / 1461;
+  const int32_t e = c - (1461 * d) / 4;
+  const int32_t m = (5 * e + 2) / 153;
+
+  day = static_cast<int>(e - (153 * m + 2) / 5 + 1);
+  month = static_cast<int>(m + 3 - 12 * (m / 10));
+  year = static_cast<int>(b * 100 + d - 4800 + m / 10);
+}
+
+LunarDate solarToLunar(int day, int month, int year, double timeZone) {
+  const int32_t dayNumber = jdFromDate(day, month, year);
+  const int32_t k = iFloor((static_cast<double>(dayNumber) - NEW_MOON_EPOCH) / SYNODIC_MONTH);
+
+  int32_t monthStart = newMoonDay(k + 1, timeZone);
+  if (monthStart > dayNumber) monthStart = newMoonDay(k, timeZone);
+
+  int32_t a11 = lunarMonth11(year, timeZone);
+  int32_t b11 = a11;
+  int lunarYear;
+  if (a11 >= monthStart) {
+    lunarYear = year;
+    a11 = lunarMonth11(year - 1, timeZone);
+  } else {
+    lunarYear = year + 1;
+    b11 = lunarMonth11(year + 1, timeZone);
+  }
+
+  LunarDate out;
+  out.day = static_cast<int>(dayNumber - monthStart + 1);
+
+  const int diff = static_cast<int>((monthStart - a11) / 29);
+  int lunarMonth = diff + 11;
+  bool leap = false;
+  if (b11 - a11 > 365) {  // 13 lunar months: one of them is intercalary
+    const int leapDiff = leapMonthOffset(a11, timeZone);
+    if (diff >= leapDiff) {
+      lunarMonth = diff + 10;
+      if (diff == leapDiff) leap = true;
+    }
+  }
+  if (lunarMonth > 12) lunarMonth -= 12;
+  if (lunarMonth >= 11 && diff < 4) lunarYear -= 1;
+
+  out.month = lunarMonth;
+  out.year = lunarYear;
+  out.leap = leap;
+  return out;
+}
+
+int daysInMonth(int month, int year) {
+  static constexpr int kDays[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+  if (month < 1 || month > 12) return 30;
+  if (month == 2 && ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0)) return 29;
+  return kDays[month - 1];
+}
+
+}  // namespace lunar
diff --git a/src/util/LunarCalendar.h b/src/util/LunarCalendar.h
new file mode 100644
index 0000000..876181e
--- /dev/null
+++ b/src/util/LunarCalendar.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <cstdint>
+
+// Vietnamese lunar calendar (âm lịch) conversion.
+//
+// Implements Hồ Ngọc Đức's algorithm (http://www.informatik.uni-leipzig.de/~duc/amlich/),
+// the reference implementation Vietnamese calendars are checked against. Vietnam keeps its
+// own lunar calendar rather than following China's: the new-moon and solar-longitude
+// instants are evaluated at UTC+7, so the two disagree by a day several times a decade.
+//
+// Resource note (AGENTS.md "Resource Justification"): every function here is pure
+// arithmetic over stack-local `double`/`int`. No heap, no statics, no I/O. The ESP32-C3
+// has no hardware FPU, so the trig runs in software float — one conversion costs on the
+// order of a few hundred microseconds, which is why callers convert the selected day
+// only, not all 42 grid cells.
+namespace lunar {
+
+// Vietnam's civil offset; the lunar calendar is defined against it.
+constexpr double VIETNAM_TIMEZONE = 7.0;
+
+struct LunarDate {
+  int day = 1;
+  int month = 1;
+  int year = 2000;
+  bool leap = false;  // true when this is the intercalary repeat of `month`
+};
+
+// Gregorian (or Julian before 1582-10-15) date -> Julian day number.
+int32_t jdFromDate(int day, int month, int year);
+
+// Inverse of jdFromDate.
+void jdToDate(int32_t jd, int& day, int& month, int& year);
+
+// Convert a solar (Gregorian) date to the Vietnamese lunar date.
+LunarDate solarToLunar(int day, int month, int year, double timeZone = VIETNAM_TIMEZONE);
+
+// Day of week for a Julian day number. 0 = Sunday .. 6 = Saturday.
+inline int weekdayFromJd(int32_t jd) { return static_cast<int>((jd + 1) % 7); }
+
+// Days in a Gregorian month (handles leap years).
+int daysInMonth(int month, int year);
+
+}  // namespace lunar
