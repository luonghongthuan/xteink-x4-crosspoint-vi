+// Civil date <-> Unix epoch, self-contained so the HAL keeps no dependency on
+// newlib's optional timegm(). Days are counted from 1970-01-01 via the standard
+// days-from-civil formula (Howard Hinnant, "chrono-Compatible Low-Level Date
+// Algorithms"), valid for any Gregorian date the RTC or NTP can produce.
+namespace {
+
+int64_t daysFromCivil(int y, unsigned m, unsigned d) {
+  y -= m <= 2;
+  const int64_t era = (y >= 0 ? y : y - 399) / 400;
+  const unsigned yoe = static_cast<unsigned>(y - era * 400);            // [0, 399]
+  const unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;  // [0, 365]
+  const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;           // [0, 146096]
+  return era * 146097 + static_cast<int64_t>(doe) - 719468;
+}
+
+void civilFromDays(int64_t z, int& y, unsigned& m, unsigned& d) {
+  z += 719468;
+  const int64_t era = (z >= 0 ? z : z - 146096) / 146097;
+  const unsigned doe = static_cast<unsigned>(z - era * 146097);                // [0, 146096]
+  const unsigned yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;  // [0, 399]
+  const int64_t yr = static_cast<int64_t>(yoe) + era * 400;
+  const unsigned doy = doe - (365 * yoe + yoe / 4 - yoe / 100);  // [0, 365]
+  const unsigned mp = (5 * doy + 2) / 153;                       // [0, 11]
+  d = doy - (153 * mp + 2) / 5 + 1;                              // [1, 31]
+  m = mp + (mp < 10 ? 3 : -9);                                   // [1, 12]
+  y = static_cast<int>(yr + (m <= 2));
+}
+
+// Floor division/modulo, so negative epochs (pre-1970) still land on the right day.
+int64_t floorDiv(int64_t a, int64_t b) { return (a >= 0 ? a : a - (b - 1)) / b; }
+
+}  // namespace
+
+bool HalClock::getUtcEpoch(int64_t& out) const {
+  if (_available) {
+    Rtc::DateTime dt;
+    if (!_sdkRtc.now(dt)) return false;
+    out = daysFromCivil(dt.year, dt.month, dt.day) * 86400 + dt.hour * 3600 + dt.minute * 60 + dt.second;
+    return true;
+  }
+  if (_softValid) {
+    out = static_cast<int64_t>(time(nullptr));
+    return true;
+  }
+  return false;
+}
+
+bool HalClock::getLocalDateTime(Rtc::DateTime& out, uint8_t utcOffsetQuarterHoursBiased) const {
+  int64_t epoch;
+  if (!getUtcEpoch(epoch)) return false;
+
+  // Same clamp as formatTime: a corrupted persisted value must not shift the date.
+  if (utcOffsetQuarterHoursBiased > 104) utcOffsetQuarterHoursBiased = 104;
+  epoch += (static_cast<int>(utcOffsetQuarterHoursBiased) - 48) * 15 * 60;
+
+  const int64_t days = floorDiv(epoch, 86400);
+  const int64_t secOfDay = epoch - days * 86400;
+
+  int year;
+  unsigned month, day;
+  civilFromDays(days, year, month, day);
+
+  out.year = static_cast<uint16_t>(year);
+  out.month = static_cast<uint8_t>(month);
+  out.day = static_cast<uint8_t>(day);
+  out.hour = static_cast<uint8_t>(secOfDay / 3600);
+  out.minute = static_cast<uint8_t>((secOfDay / 60) % 60);
+  out.second = static_cast<uint8_t>(secOfDay % 60);
+  // 1970-01-01 was a Thursday (weekday 4); floorDiv keeps this correct before 1970.
+  out.weekday = static_cast<uint8_t>(((days % 7) + 11) % 7);
+  return true;
+}
