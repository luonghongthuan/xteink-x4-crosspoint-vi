diff --git a/src/util/BlePageTurner.cpp b/src/util/BlePageTurner.cpp
new file mode 100644
index 0000000..7574537
--- /dev/null
+++ b/src/util/BlePageTurner.cpp
@@ -0,0 +1,87 @@
+#include "util/BlePageTurner.h"
+
+#include <BleKeyboardHost.h>
+#include <Logging.h>
+
+#include "CrossPointSettings.h"
+
+namespace blepage {
+namespace {
+
+bool nextLatched = false;
+bool prevLatched = false;
+
+// Page turners are HID keyboards with two or three keys, and vendors disagree on
+// which ones they send. Accepting the whole family costs nothing and saves the
+// user from discovering their remote sends Down where another sends PageDown.
+bool isNextKey(const freeink::KeyEvent& k) {
+  using SK = freeink::SpecialKey;
+  if (k.special == SK::Right || k.special == SK::Down || k.special == SK::PageDown ||
+      k.special == SK::Enter) {
+    return true;
+  }
+  // Space is the most common single-key remote, and 'n' shows up on a few.
+  return k.ch == ' ' || k.ch == 'n' || k.ch == 'N';
+}
+
+bool isPrevKey(const freeink::KeyEvent& k) {
+  using SK = freeink::SpecialKey;
+  if (k.special == SK::Left || k.special == SK::Up || k.special == SK::PageUp ||
+      k.special == SK::Backspace) {
+    return true;
+  }
+  return k.ch == 'p' || k.ch == 'P';
+}
+
+}  // namespace
+
+void service() {
+  const bool want = SETTINGS.bleEnabled != 0;
+  const bool running = BleKbd.isRunning();
+
+  if (want && !running) {
+    // hostName is what the page turner shows while pairing.
+    if (!BleKbd.begin("CrossPoint")) {
+      LOG_ERR("BLEPG", "BLE init failed; turning the setting back off");
+      SETTINGS.bleEnabled = 0;
+    }
+    return;
+  }
+  if (!want) {
+    if (running) {
+      // end(), not disconnect(): this returns the NimBLE host and controller
+      // RAM to the heap, which EPUB inflate needs.
+      BleKbd.end();
+      nextLatched = prevLatched = false;
+    }
+    return;
+  }
+
+  BleKbd.poll();
+
+  freeink::KeyEvent key;
+  while (BleKbd.popKey(key)) {
+    if (isNextKey(key)) {
+      nextLatched = true;
+    } else if (isPrevKey(key)) {
+      prevLatched = true;
+    }
+  }
+}
+
+bool takeNext() {
+  const bool v = nextLatched;
+  nextLatched = false;
+  return v;
+}
+
+bool takePrev() {
+  const bool v = prevLatched;
+  prevLatched = false;
+  return v;
+}
+
+bool isRunning() { return BleKbd.isRunning(); }
+bool isConnected() { return BleKbd.isConnected(); }
+
+}  // namespace blepage
diff --git a/src/util/BlePageTurner.h b/src/util/BlePageTurner.h
new file mode 100644
index 0000000..377e556
--- /dev/null
+++ b/src/util/BlePageTurner.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <cstdint>
+
+// Turns key presses from a paired Bluetooth page turner into page-turn requests.
+//
+// A BLE page turner is just a HID keyboard with two or three keys, so the raw
+// events arrive through the SDK's BleKeyboardHost. This layer owns three things
+// the reader should not have to know about: when the stack is allowed to be
+// resident, which keycodes count as forward and back, and the latch that carries
+// a press from the main loop into the reader's input poll.
+//
+// The latch mirrors how the tilt sensor already feeds ReaderUtils::detectPageTurn:
+// the main loop drains the key queue once per iteration, and the reader consumes
+// a one-shot flag. Without it, key events arriving between reader polls would be
+// dropped, because the reader only samples input while a page is on screen.
+//
+// Resource note (AGENTS.md "Resource Justification"): two bools and no heap here.
+// The NimBLE stack itself costs tens of KB of heap, which is why `service()`
+// tears it down the moment the user turns the setting off rather than leaving it
+// resident — EPUB inflate needs that heap back.
+namespace blepage {
+
+// Call once per main-loop iteration. Starts or stops the BLE stack to match
+// SETTINGS.bleEnabled, pumps the host, and latches any page-turn key.
+void service();
+
+// One-shot reads, consumed by the reader's page-turn detection.
+bool takeNext();
+bool takePrev();
+
+// True while the BLE stack is initialised. Used by the pairing screen, and by
+// callers that must not start heavy work while the radio is up.
+bool isRunning();
+
+// True while a page turner is connected and delivering keys.
+bool isConnected();
+
+}  // namespace blepage
diff --git a/src/util/CanChi.cpp b/src/util/CanChi.cpp
new file mode 100644
index 0000000..47c90a8
--- /dev/null
+++ b/src/util/CanChi.cpp
@@ -0,0 +1,99 @@
+#include "util/CanChi.h"
+
+namespace canchi {
+namespace {
+
+constexpr const char* CAN_NAMES[CAN_COUNT] = {"Giáp", "Ất",   "Bính", "Đinh", "Mậu",
+                                              "Kỷ",   "Canh", "Tân",  "Nhâm", "Quý"};
+
+constexpr const char* CHI_NAMES[CHI_COUNT] = {"Tý",  "Sửu", "Dần", "Mão", "Thìn", "Tỵ",
+                                              "Ngọ", "Mùi", "Thân", "Dậu", "Tuất", "Hợi"};
+
+// The twelve tutelary spirits, in cycle order starting from Thanh Long.
+constexpr const char* GOD_NAMES[GOD_COUNT] = {
+    "Thanh Long", "Minh Đường", "Thiên Hình", "Chu Tước", "Kim Quỹ",  "Kim Đường",
+    "Bạch Hổ",    "Ngọc Đường", "Thiên Lao",  "Nguyên Vũ", "Tư Mệnh", "Câu Trần"};
+
+// Bit i set => spirit i is hoàng đạo. Thanh Long, Minh Đường, Kim Quỹ, Kim Đường,
+// Ngọc Đường, Tư Mệnh are the auspicious six; the other six are hắc đạo.
+constexpr uint16_t AUSPICIOUS_GODS = (1u << 0) | (1u << 1) | (1u << 4) | (1u << 5) | (1u << 7) | (1u << 10);
+
+constexpr const char* TERM_NAMES[TERM_COUNT] = {
+    "Lập Xuân",  "Vũ Thủy",   "Kinh Trập", "Xuân Phân", "Thanh Minh", "Cốc Vũ",
+    "Lập Hạ",    "Tiểu Mãn",  "Mang Chủng", "Hạ Chí",   "Tiểu Thử",   "Đại Thử",
+    "Lập Thu",   "Xử Thử",    "Bạch Lộ",   "Thu Phân",  "Hàn Lộ",     "Sương Giáng",
+    "Lập Đông",  "Tiểu Tuyết", "Đại Tuyết", "Đông Chí", "Tiểu Hàn",   "Đại Hàn"};
+
+constexpr const char* CHI_HOURS[CHI_COUNT] = {"23-01", "01-03", "03-05", "05-07", "07-09", "09-11",
+                                              "11-13", "13-15", "15-17", "17-19", "19-21", "21-23"};
+
+// Branch on which the Thanh Long cycle starts, indexed by lunar month 1..12. Months
+// pair up (1 and 7, 2 and 8, ...), so the table is a six-entry pattern repeated twice:
+// Thân, Tuất, Tý, Dần, Thìn, Ngọ.
+constexpr int GOD_START_CHI[12] = {8, 10, 0, 2, 4, 6, 8, 10, 0, 2, 4, 6};
+
+// Auspicious double-hours, indexed by the day's branch. Days pair up the same way the
+// months do, so six distinct masks cover all twelve branches:
+//   Tý/Ngọ    Tý Sửu Mão Ngọ Thân Dậu
+//   Sửu/Mùi   Dần Mão Tỵ Thân Tuất Hợi
+//   Dần/Thân  Tý Sửu Thìn Tỵ Mùi Tuất
+//   Mão/Dậu   Tý Dần Mão Ngọ Mùi Dậu
+//   Thìn/Tuất Dần Thìn Tỵ Thân Dậu Hợi
+//   Tỵ/Hợi    Sửu Thìn Ngọ Mùi Tuất Hợi
+constexpr uint16_t bit(int chi) { return static_cast<uint16_t>(1u << chi); }
+
+constexpr uint16_t HOUR_MASKS[6] = {
+    static_cast<uint16_t>(bit(0) | bit(1) | bit(3) | bit(6) | bit(8) | bit(9)),
+    static_cast<uint16_t>(bit(2) | bit(3) | bit(5) | bit(8) | bit(10) | bit(11)),
+    static_cast<uint16_t>(bit(0) | bit(1) | bit(4) | bit(5) | bit(7) | bit(10)),
+    static_cast<uint16_t>(bit(0) | bit(2) | bit(3) | bit(6) | bit(7) | bit(9)),
+    static_cast<uint16_t>(bit(2) | bit(4) | bit(5) | bit(8) | bit(9) | bit(11)),
+    static_cast<uint16_t>(bit(1) | bit(4) | bit(6) | bit(7) | bit(10) | bit(11))};
+
+// Positive modulo — the day pillar formulas can go negative for dates before the epoch.
+constexpr int mod(int v, int m) { return ((v % m) + m) % m; }
+
+}  // namespace
+
+const char* canName(int can) { return (can >= 0 && can < CAN_COUNT) ? CAN_NAMES[can] : "?"; }
+const char* chiName(int chi) { return (chi >= 0 && chi < CHI_COUNT) ? CHI_NAMES[chi] : "?"; }
+const char* godName(int god) { return (god >= 0 && god < GOD_COUNT) ? GOD_NAMES[god] : "?"; }
+const char* solarTermName(int term) { return (term >= 0 && term < TERM_COUNT) ? TERM_NAMES[term] : "?"; }
+const char* chiHourRange(int chi) { return (chi >= 0 && chi < CHI_COUNT) ? CHI_HOURS[chi] : "?"; }
+
+uint16_t auspiciousHourMask(int dayChi) {
+  if (dayChi < 0 || dayChi >= CHI_COUNT) {
+    return 0;
+  }
+  return HOUR_MASKS[dayChi % 6];
+}
+
+DayInfo dayInfo(int32_t jd, const lunar::LunarDate& ld) {
+  DayInfo info;
+
+  // Day pillar runs straight off the Julian day number; the +9/+1 offsets align the
+  // cycle so that JD 2451545 (2000-01-01) comes out Mậu Ngọ, which is what almanacs print.
+  info.dayCan = mod(static_cast<int>(jd) + 9, CAN_COUNT);
+  info.dayChi = mod(static_cast<int>(jd) + 1, CHI_COUNT);
+
+  // Year pillar is anchored to the LUNAR year, so a January date still belongs to the
+  // outgoing animal until Tết.
+  info.yearCan = mod(ld.year + 6, CAN_COUNT);
+  info.yearChi = mod(ld.year + 8, CHI_COUNT);
+
+  // Month pillar counts lunar months from the start of the sexagenary cycle. A leap
+  // month repeats its neighbour's pillar, which is why `ld.leap` is not consulted.
+  info.monthCan = mod(ld.year * 12 + ld.month + 3, CAN_COUNT);
+  info.monthChi = mod(ld.month + 1, CHI_COUNT);
+
+  // The spirit cycle starts on a branch fixed by the lunar month, then advances one
+  // step per branch as the days turn.
+  const int start = GOD_START_CHI[mod(ld.month - 1, 12)];
+  info.god = mod(info.dayChi - start, GOD_COUNT);
+  info.auspicious = (AUSPICIOUS_GODS >> info.god) & 1u;
+
+  info.solarTerm = lunar::solarTermIndex24(jd);
+  return info;
+}
+
+}  // namespace canchi
diff --git a/src/util/CanChi.h b/src/util/CanChi.h
new file mode 100644
index 0000000..f31a4f3
--- /dev/null
+++ b/src/util/CanChi.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <cstdint>
+
+#include "util/LunarCalendar.h"
+
+// Sexagenary cycle (Can Chi) and the day-quality reckoning Vietnamese almanacs print
+// next to each lunar date: which of the twelve tutelary spirits governs the day, whether
+// that makes it hoàng đạo (auspicious) or hắc đạo (inauspicious), and which double-hours
+// are auspicious within it.
+//
+// Resource note (AGENTS.md "Resource Justification"): every lookup here is integer
+// modulo arithmetic over `constexpr` tables that live in flash. No heap, no statics with
+// runtime initialisers, no floating point — unlike the lunar conversion itself, this
+// costs microseconds, so callers may run it per rendered cell if they want.
+//
+// The names are calendar data rather than UI chrome, so they are tables here instead of
+// `tr()` keys — the same treatment CalendarActivity already gives its month labels.
+// Sino-Vietnamese cycle names do not translate; a French or Polish UI still prints "Giáp Tý".
+namespace canchi {
+
+// Number of entries in each cycle.
+constexpr int CAN_COUNT = 10;   // Thiên Can
+constexpr int CHI_COUNT = 12;   // Địa Chi
+constexpr int GOD_COUNT = 12;   // Thập nhị trực thần
+constexpr int TERM_COUNT = 24;  // Tiết khí
+
+struct DayInfo {
+  int dayCan = 0;    // 0..9
+  int dayChi = 0;    // 0..11
+  int monthCan = 0;
+  int monthChi = 0;
+  int yearCan = 0;
+  int yearChi = 0;
+  int god = 0;              // 0..11, index into the twelve spirits
+  bool auspicious = false;  // true when `god` is one of the six hoàng đạo spirits
+  int solarTerm = 0;        // 0..23, 0 = Lập Xuân
+};
+
+// Name lookups. Out-of-range indices return "?" rather than reading past the table.
+const char* canName(int can);
+const char* chiName(int chi);
+const char* godName(int god);
+const char* solarTermName(int term);
+
+// Clock range covered by an Earth Branch double-hour, e.g. chi 0 (Tý) -> "23-01".
+const char* chiHourRange(int chi);
+
+// Full reckoning for the day `jd` falls on. `ld` must be the lunar date for the same
+// day: the month pillar and the spirit cycle are both anchored to the lunar month,
+// not the Gregorian one.
+DayInfo dayInfo(int32_t jd, const lunar::LunarDate& ld);
+
+// Bit i is set when double-hour `i` (Tý = 0) is auspicious on a day whose branch is
+// `dayChi`. Six of the twelve are auspicious on any given day.
+uint16_t auspiciousHourMask(int dayChi);
+
+}  // namespace canchi
diff --git a/src/util/LunarCalendar.cpp b/src/util/LunarCalendar.cpp
new file mode 100644
index 0000000..cfac04d
--- /dev/null
+++ b/src/util/LunarCalendar.cpp
@@ -0,0 +1,188 @@
+#include "LunarCalendar.h"
+
+#include <cmath>
+
+namespace lunar {
+namespace {
+
+constexpr double PI_ = 3.14159265358979323846;
+// Mean synodic month (days) and the Julian day of new moon k=0, per Meeus.
+constexpr double SYNODIC_MONTH = 29.530588853;
+constexpr double NEW_MOON_EPOCH = 2415021.076998695;
+
+inline int32_t iFloor(double d) { return static_cast<int32_t>(std::floor(d)); }
+
+// Julian day of the k-th new moon since 1900-01-01, from Meeus' "Astronomical
+// Algorithms" ch. 49 (the truncated series Hồ Ngọc Đức's reference uses).
+double newMoon(int32_t k) {
+  const double T = static_cast<double>(k) / 1236.85;
+  const double T2 = T * T;
+  const double T3 = T2 * T;
+  const double dr = PI_ / 180.0;
+
+  double jd1 = 2415020.75933 + 29.53058868 * k + 0.0001178 * T2 - 0.000000155 * T3;
+  jd1 += 0.00033 * std::sin((166.56 + 132.87 * T - 0.009173 * T2) * dr);
+
+  const double M = 359.2242 + 29.10535608 * k - 0.0000333 * T2 - 0.00000347 * T3;     // sun's mean anomaly
+  const double Mpr = 306.0253 + 385.81691806 * k + 0.0107306 * T2 + 0.00001236 * T3;  // moon's mean anomaly
+  const double F = 21.2964 + 390.67050646 * k - 0.0016528 * T2 - 0.00000239 * T3;     // moon's argument of latitude
+
+  double c1 = (0.1734 - 0.000393 * T) * std::sin(M * dr) + 0.0021 * std::sin(2 * dr * M);
+  c1 -= 0.4068 * std::sin(Mpr * dr);
+  c1 += 0.0161 * std::sin(dr * 2 * Mpr);
+  c1 -= 0.0004 * std::sin(dr * 3 * Mpr);
+  c1 += 0.0104 * std::sin(dr * 2 * F);
+  c1 -= 0.0051 * std::sin(dr * (M + Mpr));
+  c1 -= 0.0074 * std::sin(dr * (M - Mpr));
+  c1 += 0.0004 * std::sin(dr * (2 * F + M));
+  c1 -= 0.0004 * std::sin(dr * (2 * F - M));
+  c1 -= 0.0006 * std::sin(dr * (2 * F + Mpr));
+  c1 += 0.0010 * std::sin(dr * (2 * F - Mpr));
+  c1 += 0.0005 * std::sin(dr * (2 * Mpr + M));
+
+  double deltat;
+  if (T < -11.0) {
+    deltat = 0.001 + 0.000839 * T + 0.0002261 * T2 - 0.00000845 * T3 - 0.000000081 * T * T3;
+  } else {
+    deltat = -0.000278 + 0.000265 * T + 0.000262 * T2;
+  }
+  return jd1 + c1 - deltat;
+}
+
+// Apparent longitude of the sun, in radians, at Julian day `jdn` (TT).
+double sunLongitude(double jdn) {
+  const double T = (jdn - 2451545.0) / 36525.0;
+  const double T2 = T * T;
+  const double dr = PI_ / 180.0;
+
+  const double M = 357.52910 + 35999.05030 * T - 0.0001559 * T2 - 0.00000048 * T * T2;
+  const double L0 = 280.46645 + 36000.76983 * T + 0.0003032 * T2;
+
+  double dl = (1.914600 - 0.004817 * T - 0.000014 * T2) * std::sin(dr * M);
+  dl += (0.019993 - 0.000101 * T) * std::sin(dr * 2 * M);
+  dl += 0.000290 * std::sin(dr * 3 * M);
+
+  double l = (L0 + dl) * dr;
+  l -= PI_ * 2.0 * static_cast<double>(iFloor(l / (PI_ * 2.0)));  // normalise to [0, 2pi)
+  return l;
+}
+
+// Solar term index 0..11 (each 30 degrees) for the local day `dayNumber`.
+int sunLongitudeIndex(int32_t dayNumber, double timeZone) {
+  return static_cast<int>(iFloor(sunLongitude(dayNumber - 0.5 - timeZone / 24.0) / PI_ * 6.0));
+}
+
+// Local day on which the k-th new moon falls.
+int32_t newMoonDay(int32_t k, double timeZone) { return iFloor(newMoon(k) + 0.5 + timeZone / 24.0); }
+
+// Local day the 11th lunar month of `year` begins (the month containing the winter solstice).
+int32_t lunarMonth11(int year, double timeZone) {
+  const double off = static_cast<double>(jdFromDate(31, 12, year)) - 2415021.0;
+  int32_t k = iFloor(off / SYNODIC_MONTH);
+  int32_t nm = newMoonDay(k, timeZone);
+  if (sunLongitudeIndex(nm, timeZone) >= 9) nm = newMoonDay(k - 1, timeZone);
+  return nm;
+}
+
+// Index (from month 11) of the leap month in a 13-month lunar year.
+int leapMonthOffset(int32_t a11, double timeZone) {
+  const int32_t k = iFloor((a11 - NEW_MOON_EPOCH) / SYNODIC_MONTH + 0.5);
+  int i = 1;
+  int last = 0;
+  int arc = sunLongitudeIndex(newMoonDay(k + i, timeZone), timeZone);
+  do {
+    last = arc;
+    i++;
+    arc = sunLongitudeIndex(newMoonDay(k + i, timeZone), timeZone);
+  } while (arc != last && i < 14);
+  return i - 1;
+}
+
+}  // namespace
+
+int32_t jdFromDate(int day, int month, int year) {
+  const int32_t a = (14 - month) / 12;
+  const int32_t y = year + 4800 - a;
+  const int32_t m = month + 12 * a - 3;
+  int32_t jd = day + (153 * m + 2) / 5 + 365 * y + y / 4 - y / 100 + y / 400 - 32045;
+  if (jd < 2299161) {  // before the Gregorian cutover: fall back to the Julian calendar
+    jd = day + (153 * m + 2) / 5 + 365 * y + y / 4 - 32083;
+  }
+  return jd;
+}
+
+void jdToDate(int32_t jd, int& day, int& month, int& year) {
+  int32_t a, b, c;
+  if (jd > 2299160) {  // Gregorian
+    a = jd + 32044;
+    b = (4 * a + 3) / 146097;
+    c = a - (b * 146097) / 4;
+  } else {  // Julian
+    b = 0;
+    c = jd + 32082;
+  }
+  const int32_t d = (4 * c + 3) / 1461;
+  const int32_t e = c - (1461 * d) / 4;
+  const int32_t m = (5 * e + 2) / 153;
+
+  day = static_cast<int>(e - (153 * m + 2) / 5 + 1);
+  month = static_cast<int>(m + 3 - 12 * (m / 10));
+  year = static_cast<int>(b * 100 + d - 4800 + m / 10);
+}
+
+LunarDate solarToLunar(int day, int month, int year, double timeZone) {
+  const int32_t dayNumber = jdFromDate(day, month, year);
+  const int32_t k = iFloor((static_cast<double>(dayNumber) - NEW_MOON_EPOCH) / SYNODIC_MONTH);
+
+  int32_t monthStart = newMoonDay(k + 1, timeZone);
+  if (monthStart > dayNumber) monthStart = newMoonDay(k, timeZone);
+
+  int32_t a11 = lunarMonth11(year, timeZone);
+  int32_t b11 = a11;
+  int lunarYear;
+  if (a11 >= monthStart) {
+    lunarYear = year;
+    a11 = lunarMonth11(year - 1, timeZone);
+  } else {
+    lunarYear = year + 1;
+    b11 = lunarMonth11(year + 1, timeZone);
+  }
+
+  LunarDate out;
+  out.day = static_cast<int>(dayNumber - monthStart + 1);
+
+  const int diff = static_cast<int>((monthStart - a11) / 29);
+  int lunarMonth = diff + 11;
+  bool leap = false;
+  if (b11 - a11 > 365) {  // 13 lunar months: one of them is intercalary
+    const int leapDiff = leapMonthOffset(a11, timeZone);
+    if (diff >= leapDiff) {
+      lunarMonth = diff + 10;
+      if (diff == leapDiff) leap = true;
+    }
+  }
+  if (lunarMonth > 12) lunarMonth -= 12;
+  if (lunarMonth >= 11 && diff < 4) lunarYear -= 1;
+
+  out.month = lunarMonth;
+  out.year = lunarYear;
+  out.leap = leap;
+  return out;
+}
+
+int solarTermIndex24(int32_t jd, double timeZone) {
+  // 15-degree arcs: 0..23 counting from 0 degrees (Xuân Phân). Lập Xuân is at
+  // 315 degrees, i.e. raw index 21, so rotating by +3 puts Lập Xuân at 0 to match
+  // how the terms are conventionally listed.
+  const int raw = static_cast<int>(iFloor(sunLongitude(jd - 0.5 - timeZone / 24.0) / PI_ * 12.0));
+  return (raw + 3) % 24;
+}
+
+int daysInMonth(int month, int year) {
+  static constexpr int kDays[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+  if (month < 1 || month > 12) return 30;
+  if (month == 2 && ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0)) return 29;
+  return kDays[month - 1];
+}
+
+}  // namespace lunar
diff --git a/src/util/LunarCalendar.h b/src/util/LunarCalendar.h
new file mode 100644
index 0000000..62a3fbc
--- /dev/null
+++ b/src/util/LunarCalendar.h
@@ -0,0 +1,48 @@
+#pragma once
+
+#include <cstdint>
+
+// Vietnamese lunar calendar (âm lịch) conversion.
+//
+// Implements Hồ Ngọc Đức's algorithm (http://www.informatik.uni-leipzig.de/~duc/amlich/),
+// the reference implementation Vietnamese calendars are checked against. Vietnam keeps its
+// own lunar calendar rather than following China's: the new-moon and solar-longitude
+// instants are evaluated at UTC+7, so the two disagree by a day several times a decade.
+//
+// Resource note (AGENTS.md "Resource Justification"): every function here is pure
+// arithmetic over stack-local `double`/`int`. No heap, no statics, no I/O. The ESP32-C3
+// has no hardware FPU, so the trig runs in software float — one conversion costs on the
+// order of a few hundred microseconds, which is why callers convert the selected day
+// only, not all 42 grid cells.
+namespace lunar {
+
+// Vietnam's civil offset; the lunar calendar is defined against it.
+constexpr double VIETNAM_TIMEZONE = 7.0;
+
+struct LunarDate {
+  int day = 1;
+  int month = 1;
+  int year = 2000;
+  bool leap = false;  // true when this is the intercalary repeat of `month`
+};
+
+// Gregorian (or Julian before 1582-10-15) date -> Julian day number.
+int32_t jdFromDate(int day, int month, int year);
+
+// Inverse of jdFromDate.
+void jdToDate(int32_t jd, int& day, int& month, int& year);
+
+// Convert a solar (Gregorian) date to the Vietnamese lunar date.
+LunarDate solarToLunar(int day, int month, int year, double timeZone = VIETNAM_TIMEZONE);
+
+// Day of week for a Julian day number. 0 = Sunday .. 6 = Saturday.
+inline int weekdayFromJd(int32_t jd) { return static_cast<int>((jd + 1) % 7); }
+
+// Days in a Gregorian month (handles leap years).
+int daysInMonth(int month, int year);
+
+// Index of the 24 solar terms (tiết khí) covering Julian day `jd`, 0 = Lập Xuân.
+// The terms divide the ecliptic into 15-degree arcs; Lập Xuân sits at 315 degrees.
+int solarTermIndex24(int32_t jd, double timeZone = VIETNAM_TIMEZONE);
+
+}  // namespace lunar
diff --git a/src/util/VocabFile.cpp b/src/util/VocabFile.cpp
new file mode 100644
index 0000000..fd8ef5d
--- /dev/null
+++ b/src/util/VocabFile.cpp
@@ -0,0 +1,122 @@
+#include "util/VocabFile.h"
+
+#include <FsHelpers.h>
+#include <Logging.h>
+
+#include <cstring>
+
+namespace vocab {
+namespace {
+
+constexpr char VOCAB_DIR[] = "/vocab";
+constexpr size_t MAX_NAME_LEN = 128;
+
+// Finds the first .txt in /vocab and opens it. Directory order on FAT is
+// insertion order rather than alphabetical, so with several lists present the
+// one that wins is simply the first the filesystem returns — documented as
+// "the first .txt found" rather than promised to be sorted.
+bool openList(HalFile& file) {
+  HalFile dir;
+  if (!Storage.openFileForRead("VOCAB", VOCAB_DIR, dir) || !dir.isDirectory()) {
+    return false;
+  }
+  char name[MAX_NAME_LEN];
+  for (auto entry = dir.openNextFile(); entry; entry = dir.openNextFile()) {
+    if (entry.isDirectory()) continue;
+    entry.getName(name, MAX_NAME_LEN);
+    // Skip macOS AppleDouble siblings (._name), which are not text.
+    if (name[0] == '\0' || name[0] == '.') continue;
+    const size_t len = strlen(name);
+    if (len < 4 || strcasecmp(name + len - 4, ".txt") != 0) continue;
+
+    char path[MAX_NAME_LEN + sizeof(VOCAB_DIR) + 1];
+    snprintf(path, sizeof(path), "%s/%s", VOCAB_DIR, name);
+    if (Storage.openFileForRead("VOCAB", path, file)) {
+      LOG_DBG("VOCAB", "Using word list: %s", path);
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+bool Reader::open(const uint32_t startOffset) {
+  if (!openList(file)) {
+    return false;
+  }
+  fileLen = static_cast<uint32_t>(file.size());
+  if (fileLen == 0) {
+    return false;
+  }
+  pos = startOffset < fileLen ? startOffset : 0;
+  wrapped = false;
+  return file.seek(pos);
+}
+
+bool Reader::readLine() {
+  if (pos >= fileLen) {
+    return false;
+  }
+  if (!file.seek(pos)) {
+    return false;
+  }
+  const int got = file.read(line, MAX_LINE - 1);
+  if (got <= 0) {
+    return false;
+  }
+  line[got] = '\0';
+
+  // Cut at the first newline and place the cursor just past it. A line longer
+  // than the buffer is truncated here and the cursor lands mid-line; the next
+  // read then starts at that point and the fragment fails parseLine(), so an
+  // over-long entry is skipped rather than corrupting the ones after it.
+  char* nl = strchr(line, '\n');
+  if (nl != nullptr) {
+    *nl = '\0';
+    pos += static_cast<uint32_t>(nl - line) + 1;
+  } else {
+    pos += static_cast<uint32_t>(got);
+  }
+
+  // Tolerate CRLF lists authored on Windows.
+  const size_t len = strlen(line);
+  if (len > 0 && line[len - 1] == '\r') {
+    line[len - 1] = '\0';
+  }
+  return true;
+}
+
+bool Reader::parseLine() {
+  if (line[0] == '\0' || line[0] == '#') {
+    return false;
+  }
+  char* first = strchr(line, '|');
+  if (first == nullptr) return false;
+  char* second = strchr(first + 1, '|');
+  if (second == nullptr) return false;
+
+  *first = '\0';
+  *second = '\0';
+  fields[0] = line;
+  fields[1] = first + 1;
+  fields[2] = second + 1;
+  return fields[0][0] != '\0' && fields[1][0] != '\0';
+}
+
+bool Reader::next() {
+  // Bounded so a list of nothing but comments cannot spin: every iteration
+  // either consumes bytes or triggers the single allowed wrap.
+  for (int guard = 0; guard < 512; ++guard) {
+    if (!readLine()) {
+      if (wrapped) return false;
+      wrapped = true;
+      pos = 0;
+      continue;
+    }
+    if (parseLine()) return true;
+  }
+  return false;
+}
+
+}  // namespace vocab
diff --git a/src/util/VocabFile.h b/src/util/VocabFile.h
new file mode 100644
index 0000000..2a7930a
--- /dev/null
+++ b/src/util/VocabFile.h
@@ -0,0 +1,71 @@
+#pragma once
+
+#include <HalStorage.h>
+
+#include <cstdint>
+
+// Streams vocabulary entries off the SD card for the word-list sleep screen.
+//
+// File format, one entry per line, UTF-8:
+//
+//     word|meaning|example
+//
+// The third field is an example sentence and may be empty. Phonetics are
+// deliberately absent: the UI fonts are built from the `builtin` interval set,
+// which stops at U+021F and so has no IPA (U+0250-U+02FF) — an IPA column would
+// render as boxes. The EPUB study books carry the phonetics instead, where the
+// reader fonts (built with `ipa-chars`) can draw them.
+//
+// Blank lines and lines starting with '#' are ignored, so a list can carry
+// comments and section headers. The list lives in /vocab; the first .txt found
+// there is used, which lets a list be swapped by dropping in a different file.
+//
+// Resource note (AGENTS.md "Resource Justification"): the file is never loaded
+// whole. Reading walks forward from a saved byte offset, one buffered chunk per
+// entry, so a 12KB list and a 1MB list cost the same RAM — one MAX_LINE buffer
+// inside the reader. The caller owns that buffer's lifetime, and because it
+// pushes the object past the 256-byte stack guidance, callers allocate the
+// reader with makeUniqueNoThrow rather than on the stack.
+namespace vocab {
+
+// Longest accepted line. Vietnamese meanings are multi-byte UTF-8, so this is
+// bytes, not characters — roughly 60-70 Vietnamese characters plus the word and
+// its phonetic transcription.
+constexpr int MAX_LINE = 200;
+
+class Reader {
+ public:
+  // Opens the list and positions at `startOffset`. An offset past the end (the
+  // list shrank since the cursor was saved) restarts from the beginning.
+  // Returns false when /vocab holds no .txt file.
+  bool open(uint32_t startOffset);
+
+  // Advances to the next well-formed entry. Wraps once at end of file so a
+  // screen never comes up short; returns false only when the list holds no
+  // usable entry at all.
+  bool next();
+
+  const char* word() const { return fields[0]; }
+  const char* meaning() const { return fields[1]; }
+  const char* example() const { return fields[2]; }
+
+  // Byte offset just past the entry last returned — save this as the cursor.
+  uint32_t offset() const { return pos; }
+
+ private:
+  HalFile file;
+  char line[MAX_LINE] = {};
+  const char* fields[3] = {"", "", ""};
+  uint32_t pos = 0;
+  uint32_t fileLen = 0;
+  bool wrapped = false;
+
+  // Reads one raw line into `line`, advancing pos. False at end of file.
+  bool readLine();
+
+  // Splits `line` on '|' into fields. False when the line is a comment, blank,
+  // or lacks a word and a meaning; the example field may be empty.
+  bool parseLine();
+};
+
+}  // namespace vocab
