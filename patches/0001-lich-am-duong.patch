diff --git a/src/activities/settings/BlePairingActivity.cpp b/src/activities/settings/BlePairingActivity.cpp
new file mode 100644
index 0000000..738cb27
--- /dev/null
+++ b/src/activities/settings/BlePairingActivity.cpp
@@ -0,0 +1,234 @@
+#include "BlePairingActivity.h"
+
+#include <BleKeyboardHost.h>
+#include <GfxRenderer.h>
+#include <I18n.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+
+#include "CrossPointSettings.h"
+#include "components/UITheme.h"
+#include "fontIds.h"
+#include "util/BlePageTurner.h"
+
+namespace {
+
+constexpr uint32_t SCAN_MS = 6000;
+constexpr int ROW_HEIGHT = 44;
+
+// A scan result already bonded would appear twice; the bonded copy wins because
+// it carries the address type needed to reconnect without re-pairing.
+bool isBonded(const char* addr) {
+  for (uint8_t i = 0; i < BleKbd.pairedCount(); ++i) {
+    if (strcmp(BleKbd.paired(i).addr, addr) == 0) return true;
+  }
+  return false;
+}
+
+}  // namespace
+
+BlePairingActivity::BlePairingActivity(GfxRenderer& renderer, MappedInputManager& mappedInput)
+    : Activity("BlePairing", renderer, mappedInput) {}
+
+int BlePairingActivity::bondRows() const { return BleKbd.pairedCount(); }
+
+int BlePairingActivity::totalRows() const {
+  int n = bondRows();
+  for (uint8_t i = 0; i < BleKbd.deviceCount(); ++i) {
+    if (!isBonded(BleKbd.device(i).addr)) ++n;
+  }
+  return n;
+}
+
+void BlePairingActivity::onEnter() {
+  Activity::onEnter();
+  // The stack is owned by BlePageTurner::service(); this screen only drives it.
+  // Without the setting on there is nothing to scan with, so say so rather than
+  // silently showing an empty list.
+  if (blepage::isRunning()) {
+    BleKbd.startScan(SCAN_MS);
+  }
+  requestUpdate();
+}
+
+void BlePairingActivity::onExit() {
+  if (blepage::isRunning()) {
+    BleKbd.stopScan();
+    // Scan bookkeeping is tens of entries the reader does not need held.
+    BleKbd.releaseScanResults();
+  }
+  Activity::onExit();
+}
+
+void BlePairingActivity::moveSelection(const int delta) {
+  const int n = totalRows();
+  if (n <= 0) return;
+  selected = std::clamp(selected + delta, 0, n - 1);
+  confirmForget = false;
+  requestUpdate();
+}
+
+void BlePairingActivity::activateSelection() {
+  const int bonds = bondRows();
+
+  if (selected < bonds) {
+    const auto& dev = BleKbd.paired(static_cast<uint8_t>(selected));
+    if (confirmForget) {
+      BleKbd.forget(dev.addr);
+      confirmForget = false;
+      selected = 0;
+    } else {
+      failure[0] = '\0';
+      BleKbd.connect(dev.addr);
+    }
+    requestUpdate();
+    return;
+  }
+
+  // Walk the scan results, skipping bonded ones, to reach the chosen row.
+  int idx = selected - bonds;
+  for (uint8_t i = 0; i < BleKbd.deviceCount(); ++i) {
+    const auto& d = BleKbd.device(i);
+    if (isBonded(d.addr)) continue;
+    if (idx == 0) {
+      failure[0] = '\0';
+      BleKbd.connect(d.addr);
+      requestUpdate();
+      return;
+    }
+    --idx;
+  }
+}
+
+void BlePairingActivity::loop() {
+  ButtonNavigator::onPress({MappedInputManager::Button::Up}, [&] { moveSelection(-1); });
+  ButtonNavigator::onPress({MappedInputManager::Button::Down}, [&] { moveSelection(1); });
+  ButtonNavigator::onPreviousPress([&] { moveSelection(-1); });
+  ButtonNavigator::onNextPress([&] { moveSelection(1); });
+
+  ButtonNavigator::onPress({MappedInputManager::Button::Confirm}, [&] { activateSelection(); });
+
+  // Long press on a bonded row asks to remove the bond; a second Confirm does it.
+  buttonNavigator.onPressAndContinuous({MappedInputManager::Button::Confirm}, [&] {
+    if (selected < bondRows()) {
+      confirmForget = true;
+      requestUpdate();
+    }
+  });
+
+  ButtonNavigator::onPress({MappedInputManager::Button::Back}, [&] {
+    if (confirmForget) {
+      confirmForget = false;
+      requestUpdate();
+      return;
+    }
+    finish();
+  });
+
+  if (!blepage::isRunning()) return;
+
+  // Repaint as the scan finds devices and as the link state changes.
+  static uint8_t lastCount = 0;
+  static bool lastConnected = false;
+  static bool lastScanning = false;
+  const uint8_t count = BleKbd.deviceCount();
+  const bool connected = BleKbd.isConnected();
+  const bool scanning = BleKbd.isScanning();
+  if (count != lastCount || connected != lastConnected || scanning != lastScanning) {
+    lastCount = count;
+    lastConnected = connected;
+    lastScanning = scanning;
+    requestUpdate();
+  }
+
+  if (BleKbd.takeConnectFailure(failure, sizeof(failure))) {
+    requestUpdate();
+  }
+}
+
+void BlePairingActivity::render(RenderLock&&) {
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const Rect safe = UITheme::getInstance().getScreenSafeArea(renderer, true, false);
+
+  renderer.clearScreen();
+  GUI.drawHeader(renderer, Rect{safe.x, safe.y + metrics.topPadding, safe.width, metrics.headerHeight},
+                 tr(STR_BLE_PAGE_TURNER));
+
+  int y = safe.y + metrics.topPadding + metrics.headerHeight + 12;
+  const int left = safe.x + 12;
+  const int right = safe.x + safe.width - 12;
+  const int smallH = renderer.getLineHeight(SMALL_FONT_ID);
+  char line[96];
+
+  if (!blepage::isRunning()) {
+    renderer.drawCenteredText(UI_10_FONT_ID, safe.y + safe.height / 2 - smallH, tr(STR_BLE_TURN_ON_FIRST));
+    const auto labels = mappedInput.mapLabels(tr(STR_BACK), "", "", "");
+    GUI.drawButtonHints(renderer, labels.btn1, labels.btn2, labels.btn3, labels.btn4);
+    renderer.displayBuffer();
+    return;
+  }
+
+  // Status line: connection first, then scan progress, then any failure.
+  if (BleKbd.isConnected()) {
+    snprintf(line, sizeof(line), "%s: %s", tr(STR_BLE_CONNECTED), BleKbd.connectedName());
+  } else if (BleKbd.isConnecting()) {
+    snprintf(line, sizeof(line), "%s", tr(STR_BLE_CONNECTING));
+  } else if (BleKbd.isScanning()) {
+    snprintf(line, sizeof(line), "%s", tr(STR_BLE_SCANNING));
+  } else if (failure[0] != '\0') {
+    snprintf(line, sizeof(line), "%s", failure);
+  } else {
+    snprintf(line, sizeof(line), "%s", tr(STR_BLE_SELECT_DEVICE));
+  }
+  renderer.drawText(SMALL_FONT_ID, left, y, line);
+  y += smallH + 8;
+  renderer.drawLine(left, y, right, y);
+  y += 8;
+
+  const int listTop = y;
+  const int visibleRows = std::max(1, (safe.y + safe.height - listTop) / ROW_HEIGHT);
+  const int bonds = bondRows();
+  const int total = totalRows();
+
+  if (total == 0) {
+    renderer.drawCenteredText(SMALL_FONT_ID, listTop + ROW_HEIGHT, tr(STR_BLE_NO_DEVICES));
+  }
+
+  // Keep the cursor inside the window without storing a row list.
+  if (selected < scrollTop) scrollTop = selected;
+  if (selected >= scrollTop + visibleRows) scrollTop = selected - visibleRows + 1;
+
+  int row = 0;
+  const auto drawRow = [&](const char* name, const char* addr, const bool bonded) {
+    if (row >= scrollTop && row < scrollTop + visibleRows) {
+      const int ry = listTop + (row - scrollTop) * ROW_HEIGHT;
+      if (row == selected) {
+        renderer.drawRect(left, ry + 2, right - left, ROW_HEIGHT - 6, 2, true);
+      }
+      const bool isLive = bonded && BleKbd.isConnected() &&
+                          strcmp(BleKbd.connectedName(), name) == 0;
+      snprintf(line, sizeof(line), "%s%s", isLive ? "> " : (bonded ? "* " : "  "), name);
+      renderer.drawText(UI_10_FONT_ID, left + 8, ry + 6, line);
+      renderer.drawText(SMALL_FONT_ID, left + 8, ry + 6 + renderer.getLineHeight(UI_10_FONT_ID), addr);
+    }
+    ++row;
+  };
+
+  for (uint8_t i = 0; i < BleKbd.pairedCount(); ++i) {
+    const auto& d = BleKbd.paired(i);
+    drawRow(d.name, d.addr, true);
+  }
+  for (uint8_t i = 0; i < BleKbd.deviceCount(); ++i) {
+    const auto& d = BleKbd.device(i);
+    if (isBonded(d.addr)) continue;
+    drawRow(d.name, d.addr, false);
+  }
+
+  const char* confirmLabel = confirmForget ? tr(STR_BLE_FORGET_CONFIRM)
+                             : (selected < bonds ? tr(STR_BLE_CONNECT) : tr(STR_BLE_PAIR));
+  const auto labels = mappedInput.mapLabels(tr(STR_BACK), confirmLabel, "↑", "↓");
+  GUI.drawButtonHints(renderer, labels.btn1, labels.btn2, labels.btn3, labels.btn4);
+  renderer.displayBuffer();
+}
diff --git a/src/activities/settings/BlePairingActivity.h b/src/activities/settings/BlePairingActivity.h
new file mode 100644
index 0000000..1e32947
--- /dev/null
+++ b/src/activities/settings/BlePairingActivity.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <cstdint>
+
+#include "activities/Activity.h"
+#include "util/ButtonNavigator.h"
+
+class GfxRenderer;
+
+// Pair and manage a Bluetooth page turner.
+//
+// The screen shows bonded devices first, then whatever a scan turned up, in one
+// list. A bonded device reconnects on selection; a new one is bonded and
+// connected. Bonds live in NVS, so the device reconnects by itself on later
+// boots and this screen is only needed once per remote.
+//
+// Resource note (AGENTS.md): no heap. Rows are read straight out of the SDK's
+// fixed-capacity tables (BleKeyboardHost holds at most kMaxDiscovered scan
+// results and kMaxBonds bonds) and rendered one at a time, so the activity adds
+// only the handful of ints below. The NimBLE stack itself is already resident —
+// this screen requires SETTINGS.bleEnabled, and BlePageTurner::service() owns
+// bringing the stack up and down.
+class BlePairingActivity final : public Activity {
+ public:
+  BlePairingActivity(GfxRenderer& renderer, MappedInputManager& mappedInput);
+
+  void onEnter() override;
+  void onExit() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+
+ private:
+  ButtonNavigator buttonNavigator;
+
+  int selected = 0;
+  int scrollTop = 0;
+  // Set when a connect attempt fails, shown until the next action.
+  char failure[64] = {};
+  // Confirmation step for removing a bond, since Confirm otherwise reconnects.
+  bool confirmForget = false;
+
+  int bondRows() const;
+  int totalRows() const;
+  void activateSelection();
+  void moveSelection(int delta);
+};
