+void SleepActivity::renderVocabSleepScreen() const {
+  const auto pageWidth = renderer.getScreenWidth();
+  const auto pageHeight = renderer.getScreenHeight();
+  const int left = pageWidth / 14;
+
+  // Reader fonts, not UI fonts: this screen is meant to be read across a desk,
+  // and the UI faces are sized for chrome rather than prose.
+  constexpr int WORD_FONT = NOTOSANS_16_FONT_ID;
+  constexpr int MEANING_FONT = NOTOSANS_14_FONT_ID;
+  constexpr int EXAMPLE_FONT = NOTOSANS_12_FONT_ID;
+  const int wordH = renderer.getLineHeight(WORD_FONT);
+  const int meaningH = renderer.getLineHeight(MEANING_FONT);
+  const int exampleH = renderer.getLineHeight(EXAMPLE_FONT);
+
+  renderer.clearScreen();
+
+  int y = pageHeight / 16;
+  renderer.drawCenteredText(UI_12_FONT_ID, y, tr(STR_SLEEP_VOCAB), true, EpdFontFamily::BOLD);
+  y += renderer.getLineHeight(UI_12_FONT_ID) + 8;
+  renderer.drawLine(left, y, pageWidth - left, y);
+  y += 18;
+
+  // Heap rather than stack: the reader carries a 200-byte line buffer plus a
+  // HalFile, which together exceed the 256-byte stack guidance in AGENTS.md.
+  auto reader = makeUniqueNoThrow<vocab::Reader>();
+  if (!reader) {
+    LOG_ERR("SLP", "OOM: vocab reader");
+    return renderDefaultSleepScreen();
+  }
+
+  if (!reader->open(APP_STATE.vocabCursor)) {
+    renderer.drawCenteredText(MEANING_FONT, pageHeight / 2, tr(STR_VOCAB_NO_LIST));
+    // Still persist: in the alternating mode the caller has already flipped the
+    // turn in memory and relies on this write to carry it.
+    APP_STATE.saveToFile();
+    renderer.displayBuffer(HalDisplay::HALF_REFRESH);
+    return;
+  }
+
+  const int wanted = SETTINGS.getVocabWordCount();
+  int shown = 0;
+
+  while (shown < wanted && reader->next()) {
+    const bool hasExample = reader->example()[0] != '\0';
+    // Height this entry will occupy, so a partly drawn entry never runs off the
+    // bottom edge.
+    const int entryH = wordH + 4 + meaningH + (hasExample ? exampleH + 4 : 0) + 16;
+    if (y + entryH > pageHeight - meaningH / 2) break;
+
+    renderer.drawText(WORD_FONT, left, y, reader->word(), true, EpdFontFamily::BOLD);
+    y += wordH + 4;
+
+    renderer.drawText(MEANING_FONT, left, y, reader->meaning());
+    y += meaningH;
+
+    if (hasExample) {
+      // drawText does not wrap. The shipped list keeps examples inside the
+      // panel, but a hand-edited list can exceed it, and a sentence clipped
+      // mid-word reads worse than none — so an over-wide example is dropped.
+      const int available = pageWidth - 2 * left;
+      if (renderer.getTextWidth(EXAMPLE_FONT, reader->example(), EpdFontFamily::ITALIC) <= available) {
+        y += 4;
+        renderer.drawText(EXAMPLE_FONT, left, y, reader->example(), true, EpdFontFamily::ITALIC);
+        y += exampleH;
+      }
+    }
+    y += 16;
+    shown++;
+  }
+
+  if (shown == 0) {
+    renderer.drawCenteredText(MEANING_FONT, pageHeight / 2, tr(STR_VOCAB_NO_LIST));
+  } else {
+    // Resume past the last entry shown, so the next sleep continues the list
+    // instead of repeating it.
+    APP_STATE.vocabCursor = reader->offset();
+  }
+  // One write per sleep, covering the cursor and — in the alternating mode —
+  // the turn the caller flipped before delegating here.
+  APP_STATE.saveToFile();
+
+  renderer.displayBuffer(HalDisplay::HALF_REFRESH);
+}
