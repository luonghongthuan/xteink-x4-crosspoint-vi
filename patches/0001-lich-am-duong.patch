+#pragma once
+#include <ArduinoJson.h>
+#include <PersistableStore.h>
+
+#include <cstdint>
+
+// Lifetime reading tallies, plus the consecutive-days streak.
+//
+// Resource note (AGENTS.md "Resource Justification"): nine scalars, no heap and no
+// dynamic containers. The counters live in the singleton and are written to SD only
+// on session end or every SAVE_EVERY_PAGES turns, honouring the SD-throttling rule —
+// saving per page turn would put a JSON serialize and an SD write in the page-turn
+// path, behind storageMutex, on every turn.
+class ReadingStats : public PersistableStore<ReadingStats> {
+  ReadingStats() = default;
+
+  friend class PersistableStore<ReadingStats>;
+
+ public:
+  // Pages between background saves. A crash loses at most this many turns.
+  static constexpr uint32_t SAVE_EVERY_PAGES = 25;
+
+  uint32_t totalPages = 0;
+  uint32_t totalSeconds = 0;
+  uint32_t sessions = 0;
+  uint32_t booksFinished = 0;
+  uint32_t todayPages = 0;
+  uint32_t todaySeconds = 0;
+  uint16_t streakDays = 0;
+  uint16_t bestStreakDays = 0;
+  // Julian day number of the last day with any reading; 0 when never read.
+  int32_t lastReadJd = 0;
+
+  static const char* getFilePath() { return "/.crosspoint/reading_stats.json"; }
+  void toJson(JsonDocument& doc) const;
+  bool fromJson(JsonVariantConst doc);
+
+  // Call when a reader opens. Rolls the day over, extends or breaks the streak,
+  // and starts the session timer.
+  void beginSession();
+
+  // Call when a reader closes. Adds the elapsed time and saves.
+  void endSession();
+
+  // Call once per page actually shown. Saves every SAVE_EVERY_PAGES pages.
+  void notePageTurn();
+
+  void noteBookFinished();
+
+  // Minutes read today, for display.
+  uint32_t todayMinutes() const { return todaySeconds / 60; }
+  uint32_t totalMinutes() const { return totalSeconds / 60; }
+
+  // Average pages per minute over the lifetime, x10 so callers can print one
+  // decimal without floating point. 0 when nothing has been read.
+  uint32_t pagesPerMinuteX10() const;
+
+ private:
+  // millis() at beginSession(); 0 when no session is open.
+  uint32_t sessionStartMs = 0;
+  uint32_t pagesSinceSave = 0;
+
+  // Today's Julian day, or 0 when the clock has never been set. Reading with an
+  // unset clock still counts toward the lifetime totals but cannot move the streak.
+  static int32_t currentJd();
+
+  void rollDayTo(int32_t jd);
+};
+
+#define READING_STATS ReadingStats::getInstance()
