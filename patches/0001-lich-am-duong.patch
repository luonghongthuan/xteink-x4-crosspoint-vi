index 0000000..751ea4b
--- /dev/null
+++ b/src/activities/util/CalendarActivity.cpp
@@ -0,0 +1,183 @@
+#include "CalendarActivity.h"
+
+#include <GfxRenderer.h>
+#include <HalClock.h>
+#include <I18n.h>
+
+#include <cstdio>
+
+#include "CrossPointSettings.h"
+#include "components/UITheme.h"
+#include "fontIds.h"
+#include "util/LunarCalendar.h"
+
+namespace {
+
+// Grid geometry. 7 columns x 6 rows always fits a Gregorian month: the longest
+// case is a 31-day month starting on the last weekday of a row (37 cells).
+constexpr int GRID_COLS = 7;
+constexpr int GRID_ROWS = 6;
+
+// Monday-first, matching Vietnamese convention (calendars here start the week on
+// Monday, unlike the Sunday-first weekday index the RTC and jdFromDate return).
+const char* const WEEKDAY_LABELS[GRID_COLS] = {"T2", "T3", "T4", "T5", "T6", "T7", "CN"};
+
+const char* const MONTH_LABELS[12] = {"Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4",  "Tháng 5",  "Tháng 6",
+                                      "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12"};
+
+// 0=Sunday..6=Saturday  ->  0=Monday..6=Sunday
+int toMondayFirst(int sundayFirst) { return (sundayFirst + 6) % 7; }
+
+}  // namespace
+
+CalendarActivity::CalendarActivity(GfxRenderer& renderer, MappedInputManager& mappedInput)
+    : Activity("Calendar", renderer, mappedInput) {}
+
+void CalendarActivity::loadToday() {
+  Rtc::DateTime dt;
+  if (halClock.getLocalDateTime(dt, SETTINGS.clockUtcOffsetQ)) {
+    todayYear = dt.year;
+    todayMonth = dt.month;
+    todayDay = dt.day;
+  } else {
+    todayYear = todayMonth = todayDay = 0;
+  }
+}
+
+void CalendarActivity::jumpToToday() {
+  if (todayYear == 0) return;
+  selYear = todayYear;
+  selMonth = todayMonth;
+  selDay = todayDay;
+}
+
+void CalendarActivity::shiftDays(const int delta) {
+  // Go through the Julian day number so month and year rollover is free.
+  const int32_t jd = lunar::jdFromDate(selDay, selMonth, selYear) + delta;
+  lunar::jdToDate(jd, selDay, selMonth, selYear);
+}
+
+void CalendarActivity::onEnter() {
+  Activity::onEnter();
+  loadToday();
+  jumpToToday();  // no-op when the clock is unavailable; the default month stands
+  requestUpdate();
+}
+
+void CalendarActivity::loop() {
+  bool dirty = false;
+
+  // Left/Right (the logical NavPrevious/NavNext pair, so the orientation swap in
+  // MappedInputManager applies) step one day; the side Up/Down buttons step a
+  // week, which is the vertical move in the grid.
+  ButtonNavigator::onPreviousPress([&] {
+    shiftDays(-1);
+    dirty = true;
+  });
+  ButtonNavigator::onNextPress([&] {
+    shiftDays(1);
+    dirty = true;
+  });
+  ButtonNavigator::onPress({MappedInputManager::Button::Up}, [&] {
+    shiftDays(-7);
+    dirty = true;
+  });
+  ButtonNavigator::onPress({MappedInputManager::Button::Down}, [&] {
+    shiftDays(7);
+    dirty = true;
+  });
+  ButtonNavigator::onPress({MappedInputManager::Button::Confirm}, [&] {
+    jumpToToday();
+    dirty = true;
+  });
+  ButtonNavigator::onPress({MappedInputManager::Button::Back}, [&] { finish(); });
+
+  if (dirty) requestUpdate();
+}
+
+void CalendarActivity::render(RenderLock&&) {
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const Rect safe = UITheme::getInstance().getScreenSafeArea(renderer, true, false);
+
+  renderer.clearScreen();
+  GUI.drawHeader(renderer, Rect{safe.x, safe.y + metrics.topPadding, safe.width, metrics.headerHeight},
+                 tr(STR_CALENDAR));
+
+  int y = safe.y + metrics.topPadding + metrics.headerHeight + 12;
+
+  // Month + year
+  char title[32];
+  snprintf(title, sizeof(title), "%s %d", MONTH_LABELS[selMonth - 1], selYear);
+  renderer.drawCenteredText(UI_12_FONT_ID, y, title);
+  y += renderer.getLineHeight(UI_12_FONT_ID) + 10;
+
+  // Column layout
+  const int gridLeft = safe.x + 10;
+  const int gridWidth = safe.width - 20;
+  const int colW = gridWidth / GRID_COLS;
+  const int cellH = 44;
+
+  for (int c = 0; c < GRID_COLS; c++) {
+    const char* lbl = WEEKDAY_LABELS[c];
+    const int tw = renderer.getTextWidth(SMALL_FONT_ID, lbl);
+    renderer.drawText(SMALL_FONT_ID, gridLeft + c * colW + (colW - tw) / 2, y, lbl);
+  }
+  y += renderer.getLineHeight(SMALL_FONT_ID) + 6;
+  renderer.drawLine(gridLeft, y, gridLeft + GRID_COLS * colW, y);
+  y += 6;
+
+  // Day cells
+  const int firstWeekday = toMondayFirst(lunar::weekdayFromJd(lunar::jdFromDate(1, selMonth, selYear)));
+  const int monthDays = lunar::daysInMonth(selMonth, selYear);
+
+  for (int row = 0; row < GRID_ROWS; row++) {
+    for (int col = 0; col < GRID_COLS; col++) {
+      const int day = row * GRID_COLS + col - firstWeekday + 1;
+      if (day < 1 || day > monthDays) continue;
+
+      const int cx = gridLeft + col * colW;
+      const int cy = y + row * cellH;
+
+      char buf[4];
+      snprintf(buf, sizeof(buf), "%d", day);
+      const int tw = renderer.getTextWidth(UI_10_FONT_ID, buf);
+      const int tx = cx + (colW - tw) / 2;
+      const int ty = cy + (cellH - renderer.getLineHeight(UI_10_FONT_ID)) / 2;
+
+      const bool isToday = (todayYear != 0 && day == todayDay && selMonth == todayMonth && selYear == todayYear);
+      if (day == selDay) {
+        // Selection: a box, so it reads on a 1-bit panel without a fill that
+        // would swallow the digit.
+        renderer.drawRect(cx + 3, cy + 2, colW - 6, cellH - 6, 2, true);
+      } else if (isToday) {
+        renderer.drawLine(cx + 10, cy + cellH - 7, cx + colW - 10, cy + cellH - 7);
+      }
+      renderer.drawText(UI_10_FONT_ID, tx, ty, buf);
+    }
+  }
+
+  y += GRID_ROWS * cellH + 10;
+  renderer.drawLine(gridLeft, y, gridLeft + GRID_COLS * colW, y);
+  y += 10;
+
+  // Selected day: solar line, then the lunar date. Only this one day is
+  // converted — see the note in the header about software-float cost.
+  char line[64];
+  snprintf(line, sizeof(line), "%04d-%02d-%02d", selYear, selMonth, selDay);
+  renderer.drawText(UI_10_FONT_ID, gridLeft, y, line);
+  y += renderer.getLineHeight(UI_10_FONT_ID) + 4;
+
+  const lunar::LunarDate ld = lunar::solarToLunar(selDay, selMonth, selYear);
+  snprintf(line, sizeof(line), "%02d/%02d/%d%s %s", ld.day, ld.month, ld.year, ld.leap ? " (nhuận)" : "",
+           tr(STR_LUNAR_DATE));
+  renderer.drawText(UI_10_FONT_ID, gridLeft, y, line);
+  y += renderer.getLineHeight(UI_10_FONT_ID) + 4;
+
+  if (todayYear == 0) {
+    renderer.drawText(SMALL_FONT_ID, gridLeft, y, tr(STR_CLOCK_NOT_SET));
+  }
+
+  const auto labels = mappedInput.mapLabels(tr(STR_BACK), tr(STR_TODAY), "<", ">");
+  GUI.drawButtonHints(renderer, labels.btn1, labels.btn2, labels.btn3, labels.btn4);
+  renderer.displayBuffer();
+}
