diff --git a/src/ReadingStats.cpp b/src/ReadingStats.cpp
new file mode 100644
index 0000000..b69c101
--- /dev/null
+++ b/src/ReadingStats.cpp
@@ -0,0 +1,102 @@
+#include "ReadingStats.h"
+
+#include <Arduino.h>
+#include <HalClock.h>
+#include <Rtc.h>
+
+#include "CrossPointSettings.h"
+#include "util/LunarCalendar.h"
+
+void ReadingStats::toJson(JsonDocument& doc) const {
+  doc["totalPages"] = totalPages;
+  doc["totalSeconds"] = totalSeconds;
+  doc["sessions"] = sessions;
+  doc["booksFinished"] = booksFinished;
+  doc["todayPages"] = todayPages;
+  doc["todaySeconds"] = todaySeconds;
+  doc["streakDays"] = streakDays;
+  doc["bestStreakDays"] = bestStreakDays;
+  doc["lastReadJd"] = lastReadJd;
+}
+
+bool ReadingStats::fromJson(JsonVariantConst doc) {
+  totalPages = doc["totalPages"] | 0u;
+  totalSeconds = doc["totalSeconds"] | 0u;
+  sessions = doc["sessions"] | 0u;
+  booksFinished = doc["booksFinished"] | 0u;
+  todayPages = doc["todayPages"] | 0u;
+  todaySeconds = doc["todaySeconds"] | 0u;
+  streakDays = doc["streakDays"] | static_cast<uint16_t>(0);
+  bestStreakDays = doc["bestStreakDays"] | static_cast<uint16_t>(0);
+  lastReadJd = doc["lastReadJd"] | 0;
+  return true;
+}
+
+int32_t ReadingStats::currentJd() {
+  Rtc::DateTime dt;
+  if (!halClock.getLocalDateTime(dt, SETTINGS.clockUtcOffsetQ)) {
+    return 0;
+  }
+  return lunar::jdFromDate(dt.day, dt.month, dt.year);
+}
+
+void ReadingStats::rollDayTo(const int32_t jd) {
+  if (jd == 0 || jd == lastReadJd) {
+    return;  // clock unset, or still the same day
+  }
+  if (lastReadJd == 0) {
+    streakDays = 1;  // first ever day with a working clock
+  } else if (jd == lastReadJd + 1) {
+    if (streakDays < UINT16_MAX) streakDays++;
+  } else if (jd > lastReadJd) {
+    streakDays = 1;  // a gap: the run restarts at today
+  } else {
+    // Clock moved backwards (NTP correction, manual change). Leave the streak
+    // alone rather than inventing a break out of a clock adjustment.
+    lastReadJd = jd;
+    return;
+  }
+  if (streakDays > bestStreakDays) bestStreakDays = streakDays;
+  lastReadJd = jd;
+  todayPages = 0;
+  todaySeconds = 0;
+}
+
+void ReadingStats::beginSession() {
+  rollDayTo(currentJd());
+  sessionStartMs = millis();
+  if (sessions < UINT32_MAX) sessions++;
+}
+
+void ReadingStats::endSession() {
+  if (sessionStartMs != 0) {
+    // Unsigned subtraction, so a millis() rollover after ~49 days still yields
+    // the true elapsed span rather than a huge number.
+    const uint32_t elapsed = (millis() - sessionStartMs) / 1000u;
+    totalSeconds += elapsed;
+    todaySeconds += elapsed;
+    sessionStartMs = 0;
+  }
+  pagesSinceSave = 0;
+  saveToFile();
+}
+
+void ReadingStats::notePageTurn() {
+  totalPages++;
+  todayPages++;
+  if (++pagesSinceSave >= SAVE_EVERY_PAGES) {
+    pagesSinceSave = 0;
+    saveToFile();
+  }
+}
+
+void ReadingStats::noteBookFinished() {
+  booksFinished++;
+  saveToFile();
+}
+
+uint32_t ReadingStats::pagesPerMinuteX10() const {
+  const uint32_t minutes = totalSeconds / 60u;
+  if (minutes == 0) return 0;
+  return (totalPages * 10u) / minutes;
+}
