+uint8_t GfxRenderer::inkCoverage() const {
+  if (frameBuffer == nullptr || frameBufferSize == 0) {
+    return 0;
+  }
+  // Ink is a CLEARED bit: drawPixel() clears to draw and clearScreen() fills
+  // 0xFF for white, so the ink count is the complement of the set-bit count.
+  // Stepping a byte at a time rather than a word keeps this free of the
+  // unaligned-load fault the C3 raises on wider reads of a uint8_t buffer.
+  uint32_t setBits = 0;
+  for (uint32_t i = 0; i < frameBufferSize; ++i) {
+    setBits += static_cast<uint32_t>(__builtin_popcount(frameBuffer[i]));
+  }
+  const uint32_t totalBits = frameBufferSize * 8u;
+  return static_cast<uint8_t>(((totalBits - setBits) * 255u) / totalBits);
+}
+
 void GfxRenderer::displayBuffer(HalDisplay::RefreshMode refreshMode) const {
   auto elapsed = millis() - start_ms;
   LOG_DBG("GFX", "Time = %lu ms from clearScreen to displayBuffer", elapsed);
