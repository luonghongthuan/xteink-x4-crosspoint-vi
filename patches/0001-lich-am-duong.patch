+void SleepActivity::renderDashboardSleepScreen() const {
+  const auto pageWidth = renderer.getScreenWidth();
+  const auto pageHeight = renderer.getScreenHeight();
+  const int lineH = renderer.getLineHeight(UI_10_FONT_ID);
+  const int smallH = renderer.getLineHeight(SMALL_FONT_ID);
+  const int left = pageWidth / 8;
+
+  renderer.clearScreen();
+
+  int y = pageHeight / 6;
+  renderer.drawCenteredText(UI_12_FONT_ID, y, tr(STR_SLEEP_DASHBOARD), true, EpdFontFamily::BOLD);
+  y += renderer.getLineHeight(UI_12_FONT_ID) + 6;
+  renderer.drawLine(left, y, pageWidth - left, y);
+  y += 14;
+
+  // Today's date, solar over lunar. The clock is unset on a fresh device, in
+  // which case both lines are skipped rather than showing an epoch date.
+  char buf[72];
+  Rtc::DateTime dt;
+  if (halClock.getLocalDateTime(dt, SETTINGS.clockUtcOffsetQ)) {
+    snprintf(buf, sizeof(buf), "%02d/%02d/%04d", dt.day, dt.month, dt.year);
+    renderer.drawText(UI_10_FONT_ID, left, y, buf);
+    y += lineH + 2;
+
+    const lunar::LunarDate ld = lunar::solarToLunar(dt.day, dt.month, dt.year);
+    snprintf(buf, sizeof(buf), "%02d/%02d %s", ld.day, ld.month, tr(STR_LUNAR_DATE));
+    renderer.drawText(SMALL_FONT_ID, left, y, buf);
+    y += smallH + 16;
+  }
+
+  const ReadingStats& stats = READING_STATS;
+
+  // Today
+  snprintf(buf, sizeof(buf), "%s: %lu %s · %lu %s", tr(STR_TODAY), static_cast<unsigned long>(stats.todayPages),
+           tr(STR_STATS_PAGES), static_cast<unsigned long>(stats.todayMinutes()), tr(STR_STATS_MINUTES));
+  renderer.drawText(UI_10_FONT_ID, left, y, buf);
+  y += lineH + 6;
+
+  // Streak, with the record alongside once one has been beaten
+  if (stats.bestStreakDays > stats.streakDays) {
+    snprintf(buf, sizeof(buf), "%s: %u %s (%s %u)", tr(STR_STATS_STREAK), stats.streakDays, tr(STR_STATS_DAYS),
+             tr(STR_STATS_BEST), stats.bestStreakDays);
+  } else {
+    snprintf(buf, sizeof(buf), "%s: %u %s", tr(STR_STATS_STREAK), stats.streakDays, tr(STR_STATS_DAYS));
+  }
+  renderer.drawText(UI_10_FONT_ID, left, y, buf);
+  y += lineH + 6;
+
+  snprintf(buf, sizeof(buf), "%s: %lu", tr(STR_STATS_BOOKS), static_cast<unsigned long>(stats.booksFinished));
+  renderer.drawText(UI_10_FONT_ID, left, y, buf);
+  y += lineH + 14;
+
+  renderer.drawLine(left, y, pageWidth - left, y);
+  y += 12;
+
+  // Lifetime totals, and reading pace as one decimal without floating point.
+  snprintf(buf, sizeof(buf), "%s: %lu %s · %lu %s", tr(STR_STATS_TOTAL), static_cast<unsigned long>(stats.totalPages),
+           tr(STR_STATS_PAGES), static_cast<unsigned long>(stats.totalMinutes()), tr(STR_STATS_MINUTES));
+  renderer.drawText(SMALL_FONT_ID, left, y, buf);
+  y += smallH + 4;
+
+  const uint32_t paceX10 = stats.pagesPerMinuteX10();
+  if (paceX10 > 0) {
+    snprintf(buf, sizeof(buf), "%lu.%lu %s/%s", static_cast<unsigned long>(paceX10 / 10),
+             static_cast<unsigned long>(paceX10 % 10), tr(STR_STATS_PAGES), tr(STR_STATS_MINUTES));
+    renderer.drawText(SMALL_FONT_ID, left, y, buf);
+  }
+
+  renderer.displayBuffer(HalDisplay::HALF_REFRESH);
+}
