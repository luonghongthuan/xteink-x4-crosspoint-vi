+// The search runs for up to a few seconds; hand the CPU back often enough that
+// the idle task can feed the watchdog.
+void yieldToScheduler() { vTaskDelay(1); }
+uint32_t nowMs() { return millis(); }
+
+bool maskBit(const uint8_t* mask, const int x, const int y) {
+  return mask[y * (chess_art::PIECE_SIZE / 8) + (x >> 3)] & (0x80 >> (x & 7));
+}
