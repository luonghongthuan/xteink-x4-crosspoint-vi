+// One page of the rules guide. A page with a position draws it, and when `focus`
+// names a square the dots show where that piece may go - computed by the engine,
+// so the diagrams cannot drift from the rules.
+struct GuidePage {
+  StrId title;
+  StrId bodyA;
+  StrId bodyB;
+  const char* fen;  // nullptr for a text-only page
