@@ -0,0 +1,43 @@
+#pragma once
+
+#include <cstdint>
+
+#include "activities/Activity.h"
+
+class GfxRenderer;
+struct Rect;
+
+// 2048 on the 4x4 grid: slide the tiles with the direction buttons, equal tiles
+// merge, reach 2048 to win but keep going for a higher score. Back exits.
+//
+// Resource note (AGENTS.md): no heap and no tasks. The whole game is 16 tile
+// values plus a few ints held in the activity, recomputed into stack locals each
+// move. Randomness is a self-contained LCG seeded from millis(), so nothing is
+// pulled in for it.
+class Game2048Activity final : public Activity {
+ public:
+  Game2048Activity(GfxRenderer& renderer, MappedInputManager& mappedInput);
+
+  void onEnter() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+
+ private:
+  static constexpr int N = 4;
+
+  uint16_t tiles[N * N] = {};  // tile face value, 0 = empty
+  uint32_t score = 0;
+  uint32_t best = 0;
+  uint32_t rngState = 1;
+  bool won = false;         // reached 2048 at least once
+  bool acknowledgedWin = false;
+  bool over = false;        // no move possible
+
+  uint32_t nextRandom();
+  void reset();
+  bool spawnTile();
+  bool slide(int dRow, int dCol);  // returns true when the board changed
+  bool canMove() const;
+
+  void renderTile(int x, int y, int size, uint16_t value) const;
+};
