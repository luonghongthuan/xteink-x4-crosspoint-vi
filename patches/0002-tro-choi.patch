+  Activity::onEnter();
+  searchPool = makeUniqueNoThrow<chess::Move[]>(SEARCH_POOL_MOVES);
+  if (!searchPool) LOG_ERR("CHESS", "OOM: %d bytes", static_cast<int>(SEARCH_POOL_MOVES * sizeof(chess::Move)));
+  gameLog = makeUniqueNoThrow<GameLog>();
+  if (!gameLog) LOG_ERR("CHESS", "OOM: %d bytes", static_cast<int>(sizeof(GameLog)));
+  screen = Screen::Menu;
+  requestUpdate();
+}
+
+void ChessActivity::onExit() {
+  gameLog.reset();
+  searchPool.reset();
+  Activity::onExit();
+}
+
+void ChessActivity::refreshLegalMoves() { legalCount = board.generateLegal(legal); }
+
+void ChessActivity::startGame(const int level) {
+  levelIndex = level;
+  board.reset();
+  humanIsWhite = true;
+  gameOver = false;
+  historyCount = 0;
+  if (gameLog) gameLog->keys[0] = chess::positionKey(board);
+  selected = lastFrom = lastTo = hintFrom = hintTo = -1;
+  cursor = 12;
+  status = Status::YourTurn;
+  screen = Screen::Play;
+  refreshLegalMoves();
+}
+
+void ChessActivity::loadPuzzle(const int index) {
+  puzzleIndex = ((index % PUZZLE_COUNT) + PUZZLE_COUNT) % PUZZLE_COUNT;
+  board.setFen(PUZZLES[puzzleIndex]);
+  humanIsWhite = board.whiteToMove;
+  gameOver = false;
+  historyCount = 0;
+  selected = lastFrom = lastTo = hintFrom = hintTo = -1;
+  cursor = humanIsWhite ? 12 : 52;
+  status = Status::YourTurn;
+  screen = Screen::Puzzle;
+  refreshLegalMoves();
+}
+
+bool ChessActivity::isLegalTarget(const int from, const int to) const {
+  for (int i = 0; i < legalCount; i++) {
+    if (legal[i].from == from && legal[i].to == to) return true;
+  }
+  return false;
+}
+
+bool ChessActivity::isRepetition() const {
+  if (!gameLog) return false;
+  const uint64_t key = gameLog->keys[historyCount];
+  int seen = 0;
+  for (int i = 0; i <= historyCount; i++) {
+    if (gameLog->keys[i] == key) seen++;
+  }
+  return seen >= 3;
+}
+
+void ChessActivity::moveCursor(const int dFile, const int dRank) {
+  const int f = ((cursor & 7) + dFile + 8) % 8;
+  const int r = ((cursor >> 3) + dRank + 8) % 8;
+  cursor = r * 8 + f;
+}
+
+void ChessActivity::playMove(const chess::Move& m) {
+  chess::Undo undo;
+  board.make(m, undo);
+  if (gameLog && historyCount < MAX_HISTORY) {
+    gameLog->played[historyCount] = Played{m, undo};
+    historyCount++;
+    gameLog->keys[historyCount] = chess::positionKey(board);
+  }
+  lastFrom = m.from;
+  lastTo = m.to;
+  hintFrom = hintTo = -1;
+}
+
+bool ChessActivity::tryHumanMove(const int from, const int to) {
+  for (int i = 0; i < legalCount; i++) {
+    const chess::Move m = legal[i];
+    // Promotions always take a queen: one fewer prompt, and it is the right
+    // choice in all but composed studies.
+    if (m.from != from || m.to != to || (m.promo && m.promo != chess::QUEEN)) continue;
+
+    if (screen == Screen::Puzzle) {
+      chess::Undo undo;
+      board.make(m, undo);
+      const bool mate = searchPool && board.inCheck() && !board.hasLegalMove(searchPool.get());
+      board.unmake(m, undo);
+      if (!mate) {
+        status = Status::TryAgain;
+        return false;
+      }
+      playMove(m);
+      status = Status::Solved;
+      gameOver = true;
+      return true;
+    }
+    playMove(m);
+    return true;
+  }
+  return false;
+}
+
+void ChessActivity::updateStatusAfterMove(const bool humanJustMoved) {
+  refreshLegalMoves();
+  if (legalCount == 0) {
+    gameOver = true;
+    if (!board.inCheck()) {
+      status = Status::Stalemate;
+    } else {
+      status = humanJustMoved ? Status::YouWin : Status::YouLose;
+    }
+    return;
+  }
+  // A game too long for the log can no longer count repetitions; call it drawn.
+  if (board.halfmove >= 100 || historyCount >= MAX_HISTORY) {
+    gameOver = true;
+    status = Status::DrawFifty;
+  } else if (chess::insufficientMaterial(board)) {
+    gameOver = true;
+    status = Status::DrawMaterial;
+  } else if (isRepetition()) {
+    gameOver = true;
+    status = Status::DrawRepetition;
+  } else if (!humanJustMoved) {
+    status = board.inCheck() ? Status::Check : Status::YourTurn;
+  }
+}
+
+bool ChessActivity::search(const int depth, const uint32_t timeMs, const int noise, chess::Move& best) {
+  if (!searchPool) return false;
+  // Search a copy: the live board must stay consistent if a render is forced
+  // while the search is making and unmaking moves.
+  chess::Board scratch = board;
+  auto ctx = makeUniqueNoThrow<chess::SearchContext>();
+  if (!ctx) {
+    LOG_ERR("CHESS", "OOM: search context");
+    return false;
+  }
+  ctx->pool = searchPool.get();
+  ctx->poolSize = SEARCH_POOL_MOVES;
+  ctx->yieldFn = &yieldToScheduler;
+  ctx->nowMs = &nowMs;
+  const bool found = chess::findBestMove(scratch, depth, timeMs, noise, millis(), *ctx, best);
+  LOG_DBG("CHESS", "depth=%d nodes=%u", ctx->depthReached, static_cast<unsigned>(ctx->nodes));
+  return found;
+}
+
+void ChessActivity::engineReply() {
+  // {depth, time cap, noise}: the easy level looks one move ahead and blunders now
+  // and then; the hard level deepens until its time runs out.
+  static constexpr Level LEVELS[3] = {{1, 1000, 60}, {3, 2500, 0}, {6, 5000, 0}};
+  status = Status::Thinking;
+  requestUpdateAndWait();
+
+  const Level& level = LEVELS[levelIndex];
+  // A little noise in the first moves keeps every game from opening the same way.
+  const int noise = level.noise > 0 ? level.noise : (historyCount < 8 ? 12 : 0);
+  chess::Move best;
+  if (search(level.depth, level.timeMs, noise, best)) playMove(best);
+  updateStatusAfterMove(false);
+}
+
+void ChessActivity::showHint() {
+  if (gameOver) return;
+  hintFrom = hintTo = -1;
+  if (screen == Screen::Puzzle) {
+    for (int i = 0; i < legalCount && hintFrom < 0; i++) {
+      chess::Undo undo;
+      board.make(legal[i], undo);
+      if (searchPool && board.inCheck() && !board.hasLegalMove(searchPool.get())) {
+        hintFrom = legal[i].from;
+        hintTo = legal[i].to;
+      }
+      board.unmake(legal[i], undo);
+    }
+  } else {
+    status = Status::Thinking;
+    requestUpdateAndWait();
+    chess::Move best;
+    if (search(HINT_DEPTH, HINT_TIME_MS, 0, best)) {
+      hintFrom = best.from;
+      hintTo = best.to;
+    }
+  }
+  if (hintFrom >= 0) {
+    status = Status::HintShown;
+    cursor = hintFrom;
+    selected = -1;
+  } else {
+    status = Status::YourTurn;
+  }
+}
+
+void ChessActivity::takeBack() {
+  if (!gameLog || historyCount == 0) return;
+  // Undo the engine's reply and the move before it, so it is the player's turn again.
+  int popped = 0;
+  while (historyCount > 0 && (popped == 0 || board.whiteToMove != humanIsWhite)) {
+    historyCount--;
+    board.unmake(gameLog->played[historyCount].move, gameLog->played[historyCount].undo);
+    popped++;
+  }
+  gameOver = false;
+  selected = hintFrom = hintTo = -1;
+  if (historyCount > 0) {
+    lastFrom = gameLog->played[historyCount - 1].move.from;
+    lastTo = gameLog->played[historyCount - 1].move.to;
+  } else {
+    lastFrom = lastTo = -1;
+  }
+  refreshLegalMoves();
+  status = board.inCheck() ? Status::Check : Status::YourTurn;
+  if (board.whiteToMove != humanIsWhite) engineReply();  // took back down to an engine turn
+}
+
+int ChessActivity::pauseItems(PauseItem* out) const {
+  int n = 0;
+  out[n++] = PauseItem::Resume;
+  if (!gameOver) out[n++] = PauseItem::Hint;
+  if (pausedFrom == Screen::Play) {
+    if (historyCount > 0) out[n++] = PauseItem::Undo;
+    out[n++] = PauseItem::NewGame;
+  } else {
+    out[n++] = PauseItem::NextPuzzle;
+  }
+  out[n++] = PauseItem::Exit;
+  return n;
+}
+
+void ChessActivity::onPauseSelect() {
+  PauseItem items[MAX_PAUSE_ITEMS];
+  const int n = pauseItems(items);
+  const PauseItem chosen = items[pauseIndex < n ? pauseIndex : 0];
+  screen = pausedFrom;
+  switch (chosen) {
+    case PauseItem::Hint:
+      showHint();
+      break;
+    case PauseItem::Undo:
+      takeBack();
+      break;
+    case PauseItem::NewGame:
+      startGame(levelIndex);
+      break;
+    case PauseItem::NextPuzzle:
+      loadPuzzle(puzzleIndex + 1);
+      break;
+    case PauseItem::Exit:
+      screen = Screen::Menu;
+      break;
+    case PauseItem::Resume:
+    default:
+      break;
+  }
+}
+
+void ChessActivity::onConfirm() {
+  if (screen == Screen::Menu) {
+    if (menuIndex < 3) {
+      startGame(menuIndex);
+    } else if (menuIndex == 3) {
+      loadPuzzle(puzzleIndex);
+    } else {
+      screen = Screen::Guide;
+      loadGuidePage();
+    }
+    return;
+  }
+  if (screen == Screen::Guide) {
+    guidePage = (guidePage + 1) % GUIDE_COUNT;
+    loadGuidePage();
+    return;
+  }
+  if (screen == Screen::Pause) {
+    onPauseSelect();
+    return;
+  }
+  if (gameOver) {
+    if (screen == Screen::Puzzle) {
+      loadPuzzle(puzzleIndex + 1);
+    } else {
+      startGame(levelIndex);
+    }
+    return;
+  }
+
+  const int8_t piece = board.sq[cursor];
+  const bool ownPiece = piece != chess::EMPTY && (piece > 0) == board.whiteToMove;
+  if (selected < 0) {
+    if (ownPiece) selected = cursor;
+    return;
+  }
+  if (cursor == selected) {
+    selected = -1;
+    return;
+  }
+  if (isLegalTarget(selected, cursor)) {
+    const bool moved = tryHumanMove(selected, cursor);
+    selected = -1;
+    if (moved && screen == Screen::Play) {
+      updateStatusAfterMove(true);
+      if (!gameOver) engineReply();
+    }
+    return;
+  }
+  selected = ownPiece ? cursor : -1;  // picking another of your pieces switches the selection
+}
+
+void ChessActivity::onBack() {
+  switch (screen) {
+    case Screen::Menu:
+      finish();
+      return;
+    case Screen::Pause:
+      screen = pausedFrom;
+      return;
+    case Screen::Guide:
+      screen = Screen::Menu;
+      return;
+    default:
+      if (selected >= 0) {
+        selected = -1;
+        return;
+      }
+      pausedFrom = screen;
+      pauseIndex = 0;
+      screen = Screen::Pause;
+      return;
+  }
+}
+
+void ChessActivity::loop() {
+  bool dirty = false;
+  PauseItem items[MAX_PAUSE_ITEMS];
+  const int pauseCount = screen == Screen::Pause ? pauseItems(items) : 0;
+
+  // Lists step with the Nav pair, which already folds side Up/Down and front
+  // Left/Right into previous/next. The board needs four independent directions, so
+  // it uses the Screen* buttons instead: each maps to exactly one physical button
+  // in every orientation. Registering both for one screen would fire twice per press.
+  const bool onBoard = screen == Screen::Play || screen == Screen::Puzzle;
+  auto stepList = [&](const int delta) {
+    if (screen == Screen::Menu) {
+      menuIndex = (menuIndex + delta + MENU_ITEMS) % MENU_ITEMS;
+    } else if (screen == Screen::Guide) {
+      guidePage = (guidePage + delta + GUIDE_COUNT) % GUIDE_COUNT;
+      loadGuidePage();
+    } else {
+      pauseIndex = (pauseIndex + delta + pauseCount) % pauseCount;
+    }
+    dirty = true;
+  };
+  auto stepBoard = [&](const int dFile, const int dRank) {
+    moveCursor(dFile, dRank);
+    dirty = true;
+  };
+
+  if (onBoard) {
+    ButtonNavigator::onPress({MappedInputManager::Button::ScreenLeft}, [&] { stepBoard(-1, 0); });
+    ButtonNavigator::onPress({MappedInputManager::Button::ScreenRight}, [&] { stepBoard(1, 0); });
+    ButtonNavigator::onPress({MappedInputManager::Button::ScreenUp}, [&] { stepBoard(0, 1); });
+    ButtonNavigator::onPress({MappedInputManager::Button::ScreenDown}, [&] { stepBoard(0, -1); });
+  } else {
+    ButtonNavigator::onPreviousPress([&] { stepList(-1); });
+    ButtonNavigator::onNextPress([&] { stepList(1); });
+  }
+  ButtonNavigator::onPress({MappedInputManager::Button::Confirm}, [&] {
+    onConfirm();
+    dirty = true;
+  });
+  ButtonNavigator::onPress({MappedInputManager::Button::Back}, [&] {
+    onBack();
+    dirty = true;
+  });
+
+  if (dirty) requestUpdate();
+}
+
+const char* ChessActivity::statusText() const {
+  switch (status) {
+    case Status::Thinking:
+      return tr(STR_CHESS_THINKING);
+    case Status::Check:
+      return tr(STR_CHESS_CHECK);
+    case Status::HintShown:
+      return tr(STR_CHESS_HINT_SHOWN);
+    case Status::YouWin:
+      return tr(STR_CHESS_YOU_WIN);
+    case Status::YouLose:
+      return tr(STR_CHESS_YOU_LOSE);
+    case Status::Stalemate:
+      return tr(STR_CHESS_STALEMATE);
+    case Status::DrawRepetition:
+      return tr(STR_CHESS_DRAW_REPETITION);
+    case Status::DrawMaterial:
+      return tr(STR_CHESS_DRAW_MATERIAL);
+    case Status::DrawFifty:
+      return tr(STR_CHESS_DRAW_FIFTY);
+    case Status::Solved:
+      return tr(STR_CHESS_SOLVED);
+    case Status::TryAgain:
+      return tr(STR_CHESS_TRY_AGAIN);
+    case Status::YourTurn:
+    default:
+      if (screen == Screen::Puzzle) return humanIsWhite ? tr(STR_CHESS_WHITE_MATES) : tr(STR_CHESS_BLACK_MATES);
+      return tr(STR_CHESS_YOUR_TURN);
+  }
+}
+
+void ChessActivity::drawPiece(const int x, const int y, const int8_t piece) const {
+  const int type = (piece < 0 ? -piece : piece) - 1;
+  if (type < 0 || type > 5) return;
+  const bool white = piece > 0;
+  const uint8_t* halo = chess_art::HALO[type];
+  const uint8_t* body = chess_art::BODY[type];
+  const uint8_t* outline = chess_art::OUTLINE[type];
+
+  for (int py = 0; py < chess_art::PIECE_SIZE; py++) {
+    for (int px = 0; px < chess_art::PIECE_SIZE; px++) {
+      if (!maskBit(halo, px, py)) continue;
+      // White piece: white body with a black rim. Black piece: solid body. Both
+      // keep the white halo so they stand clear of a shaded square.
+      const bool black = maskBit(body, px, py) && (!white || maskBit(outline, px, py));
+      renderer.drawPixel(x + px, y + py, black);
+    }
+  }
+}
+
+void ChessActivity::drawCorners(const int x, const int y, const int size) const {
+  const int len = size / 3;
+  constexpr int w = 3;
+  for (int i = 0; i < 4; i++) {
+    const int cx = (i & 1) ? x + size - len : x;
+    const int cy = (i & 2) ? y + size - w : y;
+    renderer.fillRect(cx, cy, len, w, true);
+    const int vx = (i & 1) ? x + size - w : x;
+    const int vy = (i & 2) ? y + size - len : y;
+    renderer.fillRect(vx, vy, w, len, true);
+  }
+}
+
+void ChessActivity::renderList(const Rect& safe, const char* const* items, const int count, const int selectedIndex) {
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int rowH = metrics.listRowHeight;
+  const int left = safe.x + metrics.contentSidePadding;
+  const int width = safe.width - 2 * metrics.contentSidePadding;
+  int y = safe.y + metrics.topPadding + metrics.headerHeight + metrics.verticalSpacing;
+
+  for (int i = 0; i < count; i++) {
+    const bool sel = i == selectedIndex;
+    if (sel) renderer.fillRect(left, y, width, rowH, true);
+    const int textY = y + (rowH - renderer.getLineHeight(UI_12_FONT_ID)) / 2;
+    renderer.drawText(UI_12_FONT_ID, left + 12, textY, items[i], !sel);
+    y += rowH + 4;
+  }
+}
+
+void ChessActivity::renderBoard(const Rect& safe) {
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int top = safe.y + metrics.topPadding + metrics.headerHeight + BOARD_MARGIN;
+  const int availH = safe.y + safe.height - top - BOARD_MARGIN;
+  const bool landscape = safe.width > safe.height;
+  const int lineH = renderer.getLineHeight(UI_12_FONT_ID);
+
+  // Portrait keeps two text lines under the board; landscape puts them beside it.
+  const int boardRoomW = landscape ? safe.width / 2 : safe.width - 2 * BOARD_MARGIN;
+  const int boardRoomH = landscape ? availH : availH - 2 * lineH - BOARD_MARGIN;
+  int sqSize = (boardRoomW < boardRoomH ? boardRoomW : boardRoomH) / 8;
+  if (sqSize < chess_art::PIECE_SIZE) sqSize = chess_art::PIECE_SIZE;
+  const int boardPx = sqSize * 8;
+  const int boardX = landscape ? safe.x + BOARD_MARGIN : safe.x + (safe.width - boardPx) / 2;
+  const int boardY = top;
+  const int pieceOff = (sqSize - chess_art::PIECE_SIZE) / 2;
+
+  for (int s = 0; s < 64; s++) {
+    const int f = s & 7, r = s >> 3;
+    const int x = boardX + f * sqSize;
+    const int y = boardY + (7 - r) * sqSize;
+    if (((f + r) & 1) == 0) renderer.fillRectDither(x, y, sqSize, sqSize, LightGray);  // a1 is dark
+
+    if (selected >= 0 && isLegalTarget(selected, s)) {
+      const int dot = sqSize / 5;
+      renderer.fillRect(x + (sqSize - dot) / 2, y + (sqSize - dot) / 2, dot, dot, true);
+    }
+    if (board.sq[s] != chess::EMPTY) drawPiece(x + pieceOff, y + pieceOff, board.sq[s]);
+    if (s == lastFrom || s == lastTo) renderer.drawRect(x + 1, y + 1, sqSize - 2, sqSize - 2, 1, true);
+    if (s == hintFrom || s == hintTo) drawCorners(x, y, sqSize);
+  }
+  renderer.drawRect(boardX - 1, boardY - 1, boardPx + 2, boardPx + 2, 2, true);
+
+  if (selected >= 0) {
+    const int x = boardX + (selected & 7) * sqSize;
+    const int y = boardY + (7 - (selected >> 3)) * sqSize;
+    renderer.fillRect(x, y, sqSize, CURSOR_WIDTH, true);
+    renderer.fillRect(x, y + sqSize - CURSOR_WIDTH, sqSize, CURSOR_WIDTH, true);
+  }
+  {
+    const int x = boardX + (cursor & 7) * sqSize;
+    const int y = boardY + (7 - (cursor >> 3)) * sqSize;
+    renderer.drawRect(x, y, sqSize, sqSize, CURSOR_WIDTH, true);
+    renderer.drawRect(x + CURSOR_WIDTH, y + CURSOR_WIDTH, sqSize - 2 * CURSOR_WIDTH, sqSize - 2 * CURSOR_WIDTH, 1,
+                      false);
+  }
+
+  char title[48] = "";
+  if (screen == Screen::Puzzle) {
+    snprintf(title, sizeof(title), "%s %d/%d", tr(STR_CHESS_PUZZLE), puzzleIndex + 1, PUZZLE_COUNT);
+  } else {
+    const char* const names[3] = {tr(STR_CHESS_PLAY_EASY), tr(STR_CHESS_PLAY_MEDIUM), tr(STR_CHESS_PLAY_HARD)};
+    snprintf(title, sizeof(title), "%s", names[levelIndex]);
+  }
+  if (landscape) {
+    const int textX = boardX + boardPx + 2 * BOARD_MARGIN;
+    renderer.drawText(UI_12_FONT_ID, textX, boardY, statusText());
+    renderer.drawText(UI_10_FONT_ID, textX, boardY + lineH + 6, title);
+  } else {
+    const int textY = boardY + boardPx + BOARD_MARGIN;
+    renderer.drawCenteredText(UI_12_FONT_ID, textY, statusText());
+    renderer.drawCenteredText(UI_10_FONT_ID, textY + lineH + 2, title);
+  }
+}
+
+void ChessActivity::loadGuidePage() {
+  const GuidePage& page = GUIDE[guidePage];
+  legalCount = 0;
+  if (!page.fen) return;
+  board.setFen(page.fen);  // diagrams need not hold both kings, so the result is ignored
+  if (page.focus >= 0) legalCount = board.generatePseudo(legal, false);
+}
+
+void ChessActivity::renderGuide(const Rect& safe) {
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const GuidePage& page = GUIDE[guidePage];
+  const bool landscape = safe.width > safe.height;
+  const int pad = metrics.contentSidePadding;
+  const int lineH = renderer.getLineHeight(UI_12_FONT_ID);
+  int top = safe.y + metrics.topPadding + metrics.headerHeight + BOARD_MARGIN;
+
+  int textX = safe.x + pad;
+  int textW = safe.width - 2 * pad;
+  int textY = top;
+
+  if (page.fen) {
+    constexpr int sq = chess_art::PIECE_SIZE;
+    const int boardPx = sq * 8;
+    const int boardX = landscape ? safe.x + BOARD_MARGIN : safe.x + (safe.width - boardPx) / 2;
+    for (int s = 0; s < 64; s++) {
+      const int f = s & 7, r = s >> 3;
+      const int x = boardX + f * sq;
+      const int y = top + (7 - r) * sq;
+      if (((f + r) & 1) == 0) renderer.fillRectDither(x, y, sq, sq, LightGray);
+      if (board.sq[s] != chess::EMPTY) drawPiece(x, y, board.sq[s]);
+      if (s == page.focus) drawCorners(x, y, sq);
+    }
+    for (int i = 0; i < legalCount; i++) {
+      if (legal[i].from != page.focus) continue;
+      const int to = legal[i].to;
+      constexpr int dot = sq / 4;
+      const int x = boardX + (to & 7) * sq + (sq - dot) / 2;
+      const int y = top + (7 - (to >> 3)) * sq + (sq - dot) / 2;
+      renderer.fillRect(x - 2, y - 2, dot + 4, dot + 4, false);  // white rim keeps the dot visible on a piece
+      renderer.fillRect(x, y, dot, dot, true);
+    }
+    renderer.drawRect(boardX - 1, top - 1, boardPx + 2, boardPx + 2, 2, true);
+    if (landscape) {
+      textX = boardX + boardPx + 2 * BOARD_MARGIN;
+      textW = safe.x + safe.width - textX - pad;
+    } else {
+      textY = top + boardPx + BOARD_MARGIN;
+    }
+  }
+
+  renderer.drawText(UI_12_FONT_ID, textX, textY, I18N.get(page.title), true, EpdFontFamily::BOLD);
+  textY += lineH + 6;
+  for (const StrId id : {page.bodyA, page.bodyB}) {
+    for (const auto& line : renderer.wrappedText(UI_12_FONT_ID, I18N.get(id), textW, GUIDE_BODY_LINES)) {
+      renderer.drawText(UI_12_FONT_ID, textX, textY, line.c_str());
+      textY += lineH;
+    }
+    textY += lineH / 2;
+  }
+
+  char footer[24];
+  snprintf(footer, sizeof(footer), "%s %d/%d", tr(STR_CHESS_PAGE), guidePage + 1, GUIDE_COUNT);
+  const int footerY = safe.y + safe.height - renderer.getLineHeight(UI_10_FONT_ID) - 4;
+  renderer.drawText(UI_10_FONT_ID, safe.x + safe.width - pad - renderer.getTextWidth(UI_10_FONT_ID, footer), footerY,
+                    footer);
+}
+
+void ChessActivity::render(RenderLock&&) {
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const Rect safe = UITheme::getInstance().getScreenSafeArea(renderer, true, false);
+
+  renderer.clearScreen();
+  GUI.drawHeader(renderer, Rect{safe.x, safe.y + metrics.topPadding, safe.width, metrics.headerHeight}, tr(STR_CHESS));
+
+  const char* confirmLabel = tr(STR_SELECT);
+  if (screen == Screen::Menu) {
+    const char* const items[MENU_ITEMS] = {tr(STR_CHESS_PLAY_EASY), tr(STR_CHESS_PLAY_MEDIUM), tr(STR_CHESS_PLAY_HARD),
+                                           tr(STR_CHESS_PUZZLES), tr(STR_CHESS_GUIDE)};
+    renderList(safe, items, MENU_ITEMS, menuIndex);
+  } else if (screen == Screen::Guide) {
+    renderGuide(safe);
+    confirmLabel = tr(STR_CHESS_NEXT);
+  } else if (screen == Screen::Pause) {
+    PauseItem kinds[MAX_PAUSE_ITEMS];
+    const int n = pauseItems(kinds);
+    const char* labels[MAX_PAUSE_ITEMS];
+    for (int i = 0; i < n; i++) {
+      switch (kinds[i]) {
+        case PauseItem::Hint:
+          labels[i] = tr(STR_CHESS_HINT);
+          break;
+        case PauseItem::Undo:
+          labels[i] = tr(STR_CHESS_UNDO);
+          break;
+        case PauseItem::NewGame:
+          labels[i] = tr(STR_CHESS_NEW_GAME);
+          break;
+        case PauseItem::NextPuzzle:
+          labels[i] = tr(STR_CHESS_NEXT_PUZZLE);
+          break;
+        case PauseItem::Exit:
+          labels[i] = tr(STR_CHESS_EXIT);
+          break;
+        case PauseItem::Resume:
+        default:
+          labels[i] = tr(STR_CHESS_RESUME);
+          break;
+      }
+    }
+    renderList(safe, labels, n, pauseIndex);
+  } else {
+    renderBoard(safe);
+    if (gameOver) {
+      confirmLabel = screen == Screen::Puzzle ? tr(STR_CHESS_NEXT) : tr(STR_CHESS_NEW_GAME);
+    } else if (selected >= 0) {
+      confirmLabel = tr(STR_CHESS_MOVE);
+    }
+  }
+
+  const auto hints = mappedInput.mapLabels(tr(STR_BACK), confirmLabel, "<", ">");
+  GUI.drawButtonHints(renderer, hints.btn1, hints.btn2, hints.btn3, hints.btn4);
+  renderer.displayBuffer();
+}
diff --git a/src/activities/util/ChessActivity.h b/src/activities/util/ChessActivity.h
