diff --git a/scripts/gen_chess_pieces.py b/scripts/gen_chess_pieces.py
new file mode 100644
index 0000000..ce19308
--- /dev/null
+++ b/scripts/gen_chess_pieces.py
@@ -0,0 +1,91 @@
+from PIL import Image, ImageDraw, ImageFilter
+S=48; K=4
+def canvas():
+    im=Image.new("L",(S*K,S*K),0); return im, ImageDraw.Draw(im)
+def P(d,pts): d.polygon([(x*K,y*K) for x,y in pts],fill=255)
+def E(d,box): d.ellipse([v*K for v in box],fill=255)
+def R(d,box): d.rectangle([v*K for v in box],fill=255)
+def base(d): R(d,(10,38,38,43)); R(d,(13,34,35,39))
+
+def pawn():
+    im,d=canvas(); base(d); E(d,(17,9,31,23)); P(d,[(19,21),(29,21),(33,35),(15,35)]); R(d,(15,22,33,25)); return im
+def rook():
+    im,d=canvas(); base(d); R(d,(15,16,33,35)); R(d,(12,8,36,17))
+    for x in (17,27): d.rectangle([x*K,8*K,(x+4)*K,12*K],fill=0)
+    return im
+def knight():
+    im,d=canvas(); base(d)
+    P(d,[(14,35),(16,24),(12,20),(11,15),(17,9),(22,6),(24,9),(31,12),(36,20),(36,35)])
+    P(d,[(11,15),(7,21),(10,24),(16,22)])
+    d.ellipse([19*K,13*K,22*K,16*K],fill=0)
+    return im
+def bishop():
+    im,d=canvas(); base(d); E(d,(21,4,27,10)); P(d,[(24,8),(33,22),(30,35),(18,35),(15,22)])
+    d.line([(26*K,12*K),(21*K,20*K)],fill=0,width=2*K)
+    R(d,(15,30,33,33)); return im
+def queen():
+    im,d=canvas(); base(d)
+    P(d,[(9,14),(15,26),(19,11),(24,25),(29,11),(33,26),(39,14),(35,35),(13,35)])
+    for cx,cy in ((9,13),(19,10),(29,10),(39,13),(24,8)): E(d,(cx-3,cy-3,cx+3,cy+3))
+    P(d,[(22,10),(26,10),(27,26),(21,26)]); return im
+def king():
+    im,d=canvas(); base(d)
+    R(d,(22,2,26,15)); R(d,(18,6,30,10))
+    P(d,[(12,18),(18,14),(24,18),(30,14),(36,18),(34,35),(14,35)])
+    return im
+
+def down(im): return im.resize((S,S),Image.LANCZOS).point(lambda v:255 if v>=128 else 0)
+order=["PAWN","KNIGHT","BISHOP","ROOK","QUEEN","KING"]
+src={"PAWN":pawn(),"KNIGHT":knight(),"BISHOP":bishop(),"ROOK":rook(),"QUEEN":queen(),"KING":king()}
+masks={}
+for n,im in src.items():
+    body=down(im)
+    halo=body.filter(ImageFilter.MaxFilter(5))
+    inner=body.filter(ImageFilter.MinFilter(5))
+    outline=Image.composite(Image.new("L",(S,S),0),body,inner)
+    masks[n]=(halo,body,outline)
+
+def pack(im):
+    px=im.load(); out=[]
+    for y in range(S):
+        for bx in range(0,S,8):
+            b=0
+            for i in range(8):
+                if px[bx+i,y]: b|=(0x80>>i)
+            out.append(b)
+    return out
+
+with open("ChessPieces.h","w") as f:
+    f.write("#pragma once\n\n#include <cstdint>\n\n")
+    f.write("// 48x48 1-bit masks, row-major, MSB first, set bit = inside the mask.\n")
+    f.write("// HALO is the body grown by 2px (painted white so a piece reads on a shaded\n")
+    f.write("// square), OUTLINE is the 2px rim of the body. Indexed by PieceType - 1.\n")
+    f.write("// Generated by tools/gen_chess_pieces.py - edit the shapes there.\n")
+    f.write("namespace chess_art {\n\nconstexpr int PIECE_SIZE = %d;\nconstexpr int PIECE_BYTES = %d;\n\n"%(S,S*S//8))
+    for kind,idx in (("HALO",0),("BODY",1),("OUTLINE",2)):
+        f.write("constexpr uint8_t %s[6][PIECE_BYTES] = {\n"%kind)
+        for n in order:
+            data=pack(masks[n][idx]); f.write("    {  // %s\n"%n)
+            for i in range(0,len(data),16): f.write("        "+", ".join("0x%02X"%b for b in data[i:i+16])+",\n")
+            f.write("    },\n")
+        f.write("};\n\n")
+    f.write("}  // namespace chess_art\n")
+print("ChessPieces.h:", sum(1 for _ in open("ChessPieces.h")), "dong")
+
+SQ=56; prev=Image.new("L",(6*SQ,4*SQ),255); pp=prev.load()
+def dark(x0,y0):
+    for y in range(0,SQ,2):
+        for x in range(0,SQ,2): pp[x0+x,y0+y]=0
+def blit(n,x0,y0,white):
+    halo,body,outline=masks[n]; off=(SQ-S)//2
+    for y in range(S):
+        for x in range(S):
+            X,Y=x0+off+x,y0+off+y
+            if halo.getpixel((x,y)): pp[X,Y]=255
+            if body.getpixel((x,y)): pp[X,Y]=255 if white else 0
+            if white and outline.getpixel((x,y)): pp[X,Y]=0
+for i,n in enumerate(order):
+    for row,(isdark,white) in enumerate([(False,True),(True,True),(False,False),(True,False)]):
+        if isdark: dark(i*SQ,row*SQ)
+        blit(n,i*SQ,row*SQ,white)
+prev.resize((6*SQ*2,4*SQ*2),Image.NEAREST).save("preview.png"); print("preview.png")
