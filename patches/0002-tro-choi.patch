+namespace {
+
+constexpr int PASSED_BONUS[8] = {0, 5, 10, 20, 40, 70, 120, 0};
+
+// 0 (centre four squares) .. 6 (corner)
+int centreDistance(const int s) {
+  const int f = fileOf(s), r = rankOf(s);
+  return (f < 4 ? 3 - f : f - 4) + (r < 4 ? 3 - r : r - 4);
+}
+
+}  // namespace
+
+int evaluate(const Board& board) {
+  // Pass 1: material phase and pawn structure.
+  int nonPawn = 0;
+  int whiteMinRank[8], blackMaxRank[8], whiteCount[8] = {}, blackCount[8] = {};
+  for (int f = 0; f < 8; f++) {
+    whiteMinRank[f] = 8;
+    blackMaxRank[f] = -1;
+  }
+  int bishops[2] = {0, 0};
+  int kingSq[2] = {-1, -1};
+  for (int s = 0; s < 64; s++) {
+    const int8_t p = board.sq[s];
+    if (p == EMPTY) continue;
+    const int type = absPiece(p);
+    const int f = fileOf(s), r = rankOf(s);
+    if (type == PAWN) {
+      if (p > 0) {
+        whiteCount[f]++;
+        if (r < whiteMinRank[f]) whiteMinRank[f] = r;
+      } else {
+        blackCount[f]++;
+        if (r > blackMaxRank[f]) blackMaxRank[f] = r;
+      }
+    } else if (type == KING) {
+      kingSq[p > 0 ? 0 : 1] = s;
+    } else {
+      nonPawn += PIECE_VALUE[type];
+      if (type == BISHOP) bishops[p > 0 ? 0 : 1]++;
+    }
+  }
+  // 0 = full middlegame, 256 = bare endgame.
+  int endgame = (5200 - nonPawn) * 256 / 4000;
+  if (endgame < 0) endgame = 0;
+  if (endgame > 256) endgame = 256;
+
+  // Pass 2: piece scores, white minus black.
+  int score = 0;
+  int material[2] = {0, 0};
+  for (int s = 0; s < 64; s++) {
+    const int8_t p = board.sq[s];
+    if (p == EMPTY) continue;
+    const bool white = p > 0;
+    const int type = absPiece(p);
+    const int f = fileOf(s);
+    const int r = white ? rankOf(s) : 7 - rankOf(s);  // rank as seen by the piece's owner
+    const int centre = 6 - centreDistance(s);
+
+    int v = PIECE_VALUE[type];
+    switch (type) {
+      case PAWN: {
+        v += r * (5 + endgame * 7 / 256) + ((f == 3 || f == 4) ? 8 : 0);
+        bool passed = true;
+        for (int ff = f - 1; ff <= f + 1 && passed; ff++) {
+          if (ff < 0 || ff > 7) continue;
+          passed = white ? blackMaxRank[ff] <= rankOf(s) : whiteMinRank[ff] >= rankOf(s);
+        }
+        if (passed) v += PASSED_BONUS[r];
+        if ((white ? whiteCount[f] : blackCount[f]) > 1) v -= 10;
+        break;
+      }
+      case KNIGHT:
+        v += centre * 6;
+        break;
+      case BISHOP:
+        v += centre * 4;
+        break;
+      case ROOK:
+        if (r == 6) v += 15;
+        if ((white ? whiteCount[f] : blackCount[f]) == 0) v += 12;
+        break;
+      case QUEEN:
+        v += centre * 2;
+        break;
+      case KING: {
+        // Middlegame: stay home behind pawns. Endgame: walk to the centre.
+        int shield = 0;
+        const int front = rankOf(s) + (white ? 1 : -1);
+        if (front >= 0 && front < 8) {
+          for (int ff = f - 1; ff <= f + 1; ff++) {
+            if (ff >= 0 && ff < 8 && board.sq[front * 8 + ff] == (white ? PAWN : -PAWN)) shield++;
+          }
+        }
+        const int mg = (r == 0 ? 12 : 0) - centre * 6 + shield * 8;
+        const int eg = centre * 8;
+        v += (mg * (256 - endgame) + eg * endgame) / 256;
+        break;
+      }
+      default:
+        break;
+    }
+    material[white ? 0 : 1] += PIECE_VALUE[type];
+    score += white ? v : -v;
+  }
+  if (bishops[0] >= 2) score += 30;
+  if (bishops[1] >= 2) score -= 30;
+
+  // Mop-up: with a winning edge in the endgame, drive the enemy king to the rim and
+  // bring our own king close. Without this a shallow search shuffles instead of mating.
+  if (endgame > 128 && kingSq[0] >= 0 && kingSq[1] >= 0) {
+    const int edge = material[0] - material[1];
+    if (edge > 300 || edge < -300) {
+      const int loser = edge > 0 ? kingSq[1] : kingSq[0];
+      const int df = fileOf(kingSq[0]) - fileOf(kingSq[1]);
+      const int dr = rankOf(kingSq[0]) - rankOf(kingSq[1]);
+      const int kingGap = (df < 0 ? -df : df) + (dr < 0 ? -dr : dr);
+      const int bonus = centreDistance(loser) * 12 + (14 - kingGap) * 4;
+      score += edge > 0 ? bonus : -bonus;
+    }
+  }
+  return board.whiteToMove ? score : -score;
+}
+
+namespace {
+
+// Winning captures first (most valuable victim, least valuable attacker), then the
+// quiet moves that refuted a sibling position at this ply.
+int orderScore(const Board& b, const Move& m, const Move* killers) {
+  int s = 0;
+  if (m.flags & F_CAPTURE) {
+    const int victim = (m.flags & F_EN_PASSANT) ? PAWN : absPiece(b.sq[m.to]);
+    s += 2000 + PIECE_VALUE[victim] - PIECE_VALUE[absPiece(b.sq[m.from])] / 10;
+  } else if (killers) {
+    if (m == killers[0]) s += 900;
+    if (m == killers[1]) s += 800;
+  }
+  if (m.promo) s += PIECE_VALUE[m.promo];
+  return s;
+}
+
+void sortMoves(const Board& b, Move* moves, const int n, const Move* killers) {
+  for (int i = 1; i < n; i++) {
+    const Move key = moves[i];
+    const int keyScore = orderScore(b, key, killers);
+    int j = i - 1;
+    while (j >= 0 && orderScore(b, moves[j], killers) < keyScore) {
+      moves[j + 1] = moves[j];
+      j--;
+    }
+    moves[j + 1] = key;
+  }
+}
+
+void tick(SearchContext& ctx) {
+  if ((++ctx.nodes & 0x3FF) != 0) return;
+  if (ctx.yieldFn && (ctx.nodes & 0x7FF) == 0) ctx.yieldFn();
+  if (ctx.limitMs && ctx.nowMs && ctx.nowMs() - ctx.startMs >= ctx.limitMs) ctx.aborted = true;
+}
+
+int quiesce(Board& b, int alpha, const int beta, const int pliesLeft, Move* pool, const int poolSize,
+            SearchContext& ctx) {
+  tick(ctx);
+  if (ctx.aborted) return 0;
+  const int standPat = evaluate(b);
+  if (standPat >= beta) return beta;
+  if (standPat > alpha) alpha = standPat;
+  if (pliesLeft == 0 || poolSize < MAX_MOVES) return alpha;
+
+  const int n = b.generatePseudo(pool, true);
+  sortMoves(b, pool, n, nullptr);
+  const bool mover = b.whiteToMove;
+  for (int i = 0; i < n; i++) {
+    Undo u;
+    b.make(pool[i], u);
+    int score = alpha;
+    const bool legal = !b.isAttacked(b.kingSquare(mover), !mover);
+    if (legal) score = -quiesce(b, -beta, -alpha, pliesLeft - 1, pool + n, poolSize - n, ctx);
+    b.unmake(pool[i], u);
+    if (!legal) continue;
+    if (score >= beta) return beta;
+    if (score > alpha) alpha = score;
+  }
+  return alpha;
+}
+
+int negamax(Board& b, int depth, int alpha, const int beta, const int ply, Move* pool, const int poolSize,
+            SearchContext& ctx) {
+  if (ctx.aborted) return 0;
+  if (b.halfmove >= 100) return 0;
+  if (ply >= MAX_PLY - 1 || poolSize < MAX_MOVES) return evaluate(b);
+
+  // A check is forcing: look one ply further rather than stand on the horizon.
+  const bool checked = b.inCheck();
+  if (checked) depth++;
+  if (depth <= 0) return quiesce(b, alpha, beta, QUIESCENCE_PLIES, pool, poolSize, ctx);
+  tick(ctx);
+
+  const int n = b.generatePseudo(pool, false);
+  sortMoves(b, pool, n, ctx.killers[ply]);
+  const bool mover = b.whiteToMove;
+  bool anyLegal = false;
+  for (int i = 0; i < n; i++) {
+    const Move m = pool[i];
+    Undo u;
+    b.make(m, u);
+    const bool legal = !b.isAttacked(b.kingSquare(mover), !mover);
+    int score = 0;
+    if (legal) score = -negamax(b, depth - 1, -beta, -alpha, ply + 1, pool + n, poolSize - n, ctx);
+    b.unmake(m, u);
+    if (!legal) continue;
+    anyLegal = true;
+    if (ctx.aborted) return 0;
+    if (score >= beta) {
+      if (!(m.flags & F_CAPTURE) && !(m == ctx.killers[ply][0])) {
+        ctx.killers[ply][1] = ctx.killers[ply][0];
+        ctx.killers[ply][0] = m;
+      }
+      return beta;
+    }
+    if (score > alpha) alpha = score;
+  }
+  if (!anyLegal) return checked ? -MATE_SCORE + ply : 0;  // nearer mates score higher
+  return alpha;
+}
+
+}  // namespace
+
+bool findBestMove(Board& board, const int maxDepth, const uint32_t timeLimitMs, const int noise, uint32_t seed,
+                  SearchContext& ctx, Move& best) {
+  if (!ctx.pool || ctx.poolSize < MAX_MOVES * 2) return false;
+  ctx.nodes = 0;
+  ctx.depthReached = 0;
+  ctx.aborted = false;
+  ctx.limitMs = timeLimitMs;
+  ctx.startMs = ctx.nowMs ? ctx.nowMs() : 0;
+  for (auto& k : ctx.killers) k[0] = k[1] = Move{};
+
+  Move* root = ctx.pool;
+  const int n = board.generateLegal(root);
+  if (n == 0) return false;
+  sortMoves(board, root, n, nullptr);
+  best = root[0];
+  if (n == 1) return true;
+
+  Move* pool = ctx.pool + n;
+  const int poolSize = ctx.poolSize - n;
+  constexpr int INF = MATE_SCORE * 2;
+
+  for (int depth = 1; depth <= maxDepth; depth++) {
+    int alpha = -INF;
+    int bestIndex = 0;
+    int completed = 0;
+    for (int i = 0; i < n; i++) {
+      Undo u;
+      board.make(root[i], u);
+      // Noise needs exact scores for every move, so it searches a full window.
+      int score = -negamax(board, depth - 1, -INF, noise > 0 ? INF : -alpha, 1, pool, poolSize, ctx);
+      board.unmake(root[i], u);
+      if (ctx.aborted) break;
+      completed++;
+
+      if (noise > 0 && score > -MATE_SCORE / 2 && score < MATE_SCORE / 2) {
+        seed = seed * 1664525u + 1013904223u;
+        score += static_cast<int>((seed >> 16) % static_cast<uint32_t>(2 * noise + 1)) - noise;
+      }
+      if (score > alpha) {
+        alpha = score;
+        bestIndex = i;
+      }
+    }
+    // The previous best is searched first, so even a partial pass can only improve on it.
+    if (completed > 0) {
+      best = root[bestIndex];
+      const Move front = root[bestIndex];
+      for (int i = bestIndex; i > 0; i--) root[i] = root[i - 1];
+      root[0] = front;
+    }
+    if (ctx.aborted) break;
+    ctx.depthReached = depth;
+    if (alpha > MATE_SCORE / 2) break;  // a forced mate needs no deeper look
+  }
+  return true;
+}
+
+}  // namespace chess
diff --git a/lib/Chess/ChessEngine.h b/lib/Chess/ChessEngine.h
new file mode 100644
index 0000000..0df6094
--- /dev/null
+++ b/lib/Chess/ChessEngine.h
@@ -0,0 +1,101 @@
+#pragma once
+
+#include <cstdint>
+
+// Small, allocation-free chess core: legal move generation, make/unmake and a
+// fixed-depth alpha-beta search. No Arduino or HAL dependency, so the same
+// translation unit builds natively for the perft tests in test/chess_native.
+namespace chess {
+
+enum PieceType : int8_t { EMPTY = 0, PAWN = 1, KNIGHT = 2, BISHOP = 3, ROOK = 4, QUEEN = 5, KING = 6 };
+
+enum MoveFlag : uint8_t { F_NONE = 0, F_CAPTURE = 1, F_EN_PASSANT = 2, F_CASTLE = 4, F_DOUBLE_PUSH = 8 };
+
+enum CastleRight : uint8_t { WHITE_KINGSIDE = 1, WHITE_QUEENSIDE = 2, BLACK_KINGSIDE = 4, BLACK_QUEENSIDE = 8 };
+
+// Squares are rank * 8 + file, a1 = 0 .. h8 = 63.
+struct Move {
+  uint8_t from = 0;
+  uint8_t to = 0;
+  uint8_t promo = EMPTY;  // PieceType promoted to, EMPTY when not a promotion
+  uint8_t flags = F_NONE;
+
+  bool operator==(const Move& o) const { return from == o.from && to == o.to && promo == o.promo; }
+};
+
+struct Undo {
+  int8_t captured;
+  uint8_t castling;
+  int8_t epSquare;
+  uint8_t halfmove;
+};
+
+// No legal position has more moves than this (the known maximum is 218).
+constexpr int MAX_MOVES = 220;
+
+class Board {
+ public:
+  int8_t sq[64];  // > 0 white, < 0 black, magnitude is the PieceType
+  bool whiteToMove;
+  uint8_t castling;
+  int8_t epSquare;  // square a pawn may capture onto en passant, -1 when none
+  uint8_t halfmove;
+
+  Board() { reset(); }
+
+  void reset();
+  // Accepts the first four FEN fields; the move counters are optional.
+  bool setFen(const char* fen);
+
+  // `out` must hold MAX_MOVES entries. Returns the number written.
+  int generateLegal(Move* out);
+  int generatePseudo(Move* out, bool capturesOnly) const;
+
+  void make(const Move& m, Undo& u);
+  void unmake(const Move& m, const Undo& u);
+
+  bool isAttacked(int square, bool byWhite) const;
+  bool inCheck() const { return isAttacked(kingSquare(whiteToMove), !whiteToMove); }
+  int kingSquare(bool white) const;
+  // `scratch` must hold MAX_MOVES entries.
+  bool hasLegalMove(Move* scratch);
+
+  // Leaf-node count, used only to validate move generation against known values.
+  uint64_t perft(int depth, Move* pool, int poolSize);
+};
+
+// Scratch space for the search, owned by the caller so an embedded host can
+// allocate it once on entry instead of paying for it in .bss for the whole uptime.
+constexpr int MAX_PLY = 32;
+
+struct SearchContext {
+  Move* pool = nullptr;
+  int poolSize = 0;
+  void (*yieldFn)() = nullptr;    // called every few thousand nodes to feed the watchdog
+  uint32_t (*nowMs)() = nullptr;  // monotonic clock; without it the time limit is ignored
+  uint32_t nodes = 0;
+  int depthReached = 0;
+
+  // Search internals.
+  uint32_t startMs = 0;
+  uint32_t limitMs = 0;
+  bool aborted = false;
+  Move killers[MAX_PLY][2];
+};
+
+// Iterative deepening up to `maxDepth`, stopping early once `timeLimitMs` runs out
+// (0 = no limit). `noise` is a centipawn amplitude added to root scores, 0 for the
+// strongest play. Returns false when the side to move has no legal move.
+bool findBestMove(Board& board, int maxDepth, uint32_t timeLimitMs, int noise, uint32_t seed, SearchContext& ctx,
+                  Move& best);
+
+int evaluate(const Board& board);  // centipawns from the side to move's point of view
+
+// Neither side can force mate: bare kings, or a single minor piece against a bare king.
+bool insufficientMaterial(const Board& board);
+
+// Identifies a position for repetition counting: placement, side to move, castling
+// rights and en passant square, as the threefold rule defines "the same position".
+uint64_t positionKey(const Board& board);
+
+}  // namespace chess
