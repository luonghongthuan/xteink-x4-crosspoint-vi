+#pragma once
+
+#include <ChessEngine.h>
+
+#include <memory>
+
+#include "activities/Activity.h"
+
+class GfxRenderer;
+struct Rect;
+
+// Button-driven chess: play the built-in engine at three strengths, or solve
+// mate-in-one puzzles. White is always drawn at the bottom. Back opens a pause
+// menu with a hint, take-back and new game.
+//
+// Resource note (AGENTS.md): two heap blocks, both taken once in onEnter() and
+// released in onExit(): the search scratch pool (SEARCH_POOL_MOVES * 4 bytes) and
+// the game log (~5KB) behind take-back and the threefold-repetition rule. They are
+// heap rather than static because they are needed only while this screen is open;
+// as .bss they would cost the reader that DRAM for the whole uptime. They are not
+// stack because the search recurses and the loop task stack is small. A failed
+// allocation degrades the feature (no engine / no take-back) instead of crashing.
+class ChessActivity final : public Activity {
+ public:
+  ChessActivity(GfxRenderer& renderer, MappedInputManager& mappedInput);
+
+  void onEnter() override;
+  void onExit() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+
+ private:
+  enum class Screen : uint8_t { Menu, Play, Puzzle, Pause, Guide };
+  enum class Status : uint8_t {
+    YourTurn,
+    Thinking,
+    Check,
+    HintShown,
+    YouWin,
+    YouLose,
+    Stalemate,
+    DrawRepetition,
+    DrawMaterial,
+    DrawFifty,
+    Solved,
+    TryAgain
+  };
+  enum class PauseItem : uint8_t { Resume, Hint, Undo, NewGame, NextPuzzle, Exit };
+
+  struct Level {
+    int depth;
+    uint32_t timeMs;
+    int noise;
+  };
+  struct Played {
+    chess::Move move;
+    chess::Undo undo;
+  };
+  static constexpr int MAX_HISTORY = 300;
+  struct GameLog {
+    Played played[MAX_HISTORY];
+    uint64_t keys[MAX_HISTORY + 1];  // keys[i] is the position before played[i]
+  };
+
+  static constexpr int MENU_ITEMS = 5;
+  static constexpr int MAX_PAUSE_ITEMS = 5;
+  static constexpr int SEARCH_POOL_MOVES = 2048;
+
+  Screen screen = Screen::Menu;
+  Screen pausedFrom = Screen::Play;
+  Status status = Status::YourTurn;
+  int menuIndex = 0;
+  int pauseIndex = 0;
+  int levelIndex = 0;
+
+  chess::Board board;
+  chess::Move legal[chess::MAX_MOVES];
+  int legalCount = 0;
+
+  std::unique_ptr<chess::Move[]> searchPool;
+  std::unique_ptr<GameLog> gameLog;
+  int historyCount = 0;
+  bool humanIsWhite = true;
+  bool gameOver = false;
+
+  int cursor = 12;    // e2
+  int selected = -1;  // square of the picked-up piece, -1 when none
+  int lastFrom = -1;  // most recent move, outlined so it is easy to spot
+  int lastTo = -1;
+  int hintFrom = -1;
+  int hintTo = -1;
+  int puzzleIndex = 0;
+  int guidePage = 0;
+
+  void startGame(int level);
+  void loadPuzzle(int index);
+  void refreshLegalMoves();
+  void moveCursor(int dFile, int dRank);
+  void onConfirm();
+  void onBack();
+  void onPauseSelect();
+  int pauseItems(PauseItem* out) const;
+
+  void playMove(const chess::Move& m);
+  bool tryHumanMove(int from, int to);
+  void engineReply();
+  void updateStatusAfterMove(bool humanJustMoved);
+  bool search(int depth, uint32_t timeMs, int noise, chess::Move& best);
+  void showHint();
+  void takeBack();
+  bool isLegalTarget(int from, int to) const;
+  bool isRepetition() const;
+
+  void renderList(const Rect& safe, const char* const* items, int count, int selectedIndex);
+  void renderBoard(const Rect& safe);
+  void renderGuide(const Rect& safe);
+  void loadGuidePage();
+  void drawPiece(int x, int y, int8_t piece) const;
+  void drawCorners(int x, int y, int size) const;
+  const char* statusText() const;
+};
diff --git a/src/activities/util/Game2048Activity.cpp b/src/activities/util/Game2048Activity.cpp
new file mode 100644
index 0000000..1bac43b
--- /dev/null
+++ b/src/activities/util/Game2048Activity.cpp
@@ -0,0 +1,230 @@
+#include "Game2048Activity.h"
+
+#include <Arduino.h>
+#include <GfxRenderer.h>
+#include <I18n.h>
+
+#include <cstdio>
+
+#include "components/UITheme.h"
+#include "fontIds.h"
+#include "util/ButtonNavigator.h"
+
+namespace {
+
+constexpr int BOARD_MARGIN = 8;
+constexpr int TILE_GAP = 6;
+
+// Darker shading for higher tiles so value reads at a glance without colour.
+Color tileShade(const uint16_t value) {
+  if (value == 0) return Clear;
+  int rank = 0;
+  for (uint16_t v = value; v > 2; v >>= 1) rank++;  // 2->0, 4->1, 8->2, ...
+  if (rank <= 1) return Clear;                      // 2, 4: white, black number
+  if (rank <= 4) return LightGray;                  // 8..32
+  return DarkGray;                                  // 64+
+}
+
+int digitFont(const uint16_t value) {
+  if (value < 100) return NOTOSANS_18_FONT_ID;
+  if (value < 1000) return NOTOSANS_16_FONT_ID;
+  return NOTOSANS_14_FONT_ID;
+}
+
+}  // namespace
+
+Game2048Activity::Game2048Activity(GfxRenderer& renderer, MappedInputManager& mappedInput)
+    : Activity("2048", renderer, mappedInput) {}
+
+uint32_t Game2048Activity::nextRandom() {
+  rngState = rngState * 1664525u + 1013904223u;
+  return rngState >> 8;
+}
+
+bool Game2048Activity::spawnTile() {
+  int empty[N * N];
+  int count = 0;
+  for (int i = 0; i < N * N; i++) {
+    if (tiles[i] == 0) empty[count++] = i;
+  }
+  if (count == 0) return false;
+  const int cell = empty[nextRandom() % count];
+  tiles[cell] = (nextRandom() % 10 == 0) ? 4 : 2;  // one in ten is a 4
+  return true;
+}
+
+void Game2048Activity::reset() {
+  for (auto& t : tiles) t = 0;
+  score = 0;
+  won = false;
+  acknowledgedWin = false;
+  over = false;
+  spawnTile();
+  spawnTile();
+}
+
+void Game2048Activity::onEnter() {
+  Activity::onEnter();
+  rngState = millis() * 2654435761u + 1;
+  reset();
+  requestUpdate();
+}
+
+bool Game2048Activity::slide(const int dRow, const int dCol) {
+  // Walk each line from the far edge toward the moving direction, compacting into
+  // the leading cell and merging equal neighbours once each.
+  bool moved = false;
+  const bool horizontal = dCol != 0;
+  const int forward = (dRow + dCol) > 0;  // moving toward higher index within a line
+
+  for (int line = 0; line < N; line++) {
+    // Gather this row/column into `seq` in travel order (destination end first).
+    uint16_t seq[N];
+    int idx[N];
+    for (int i = 0; i < N; i++) {
+      const int pos = forward ? (N - 1 - i) : i;
+      const int cell = horizontal ? line * N + pos : pos * N + line;
+      idx[i] = cell;
+      seq[i] = tiles[cell];
+    }
+    // Compact non-zero values, then merge adjacent equals, then compact again.
+    uint16_t packed[N];
+    int n = 0;
+    for (int i = 0; i < N; i++) {
+      if (seq[i] != 0) packed[n++] = seq[i];
+    }
+    uint16_t result[N] = {0, 0, 0, 0};
+    int w = 0;
+    for (int i = 0; i < n; i++) {
+      if (i + 1 < n && packed[i] == packed[i + 1]) {
+        const uint16_t merged = static_cast<uint16_t>(packed[i] * 2);
+        result[w++] = merged;
+        score += merged;
+        if (merged >= 2048) won = true;
+        i++;  // consume the partner
+      } else {
+        result[w++] = packed[i];
+      }
+    }
+    for (int i = 0; i < N; i++) {
+      if (tiles[idx[i]] != result[i]) moved = true;
+      tiles[idx[i]] = result[i];
+    }
+  }
+  return moved;
+}
+
+bool Game2048Activity::canMove() const {
+  for (int r = 0; r < N; r++) {
+    for (int c = 0; c < N; c++) {
+      const uint16_t v = tiles[r * N + c];
+      if (v == 0) return true;
+      if (c + 1 < N && tiles[r * N + c + 1] == v) return true;
+      if (r + 1 < N && tiles[(r + 1) * N + c] == v) return true;
+    }
+  }
+  return false;
+}
+
+void Game2048Activity::loop() {
+  bool dirty = false;
+
+  auto move = [&](const int dRow, const int dCol) {
+    if (over) return;
+    if (slide(dRow, dCol)) {
+      spawnTile();
+      if (score > best) best = score;
+      if (!canMove()) over = true;
+      dirty = true;
+    }
+  };
+
+  ButtonNavigator::onPress({MappedInputManager::Button::ScreenLeft}, [&] { move(0, -1); });
+  ButtonNavigator::onPress({MappedInputManager::Button::ScreenRight}, [&] { move(0, 1); });
+  ButtonNavigator::onPress({MappedInputManager::Button::ScreenUp}, [&] { move(-1, 0); });
+  ButtonNavigator::onPress({MappedInputManager::Button::ScreenDown}, [&] { move(1, 0); });
+  ButtonNavigator::onPress({MappedInputManager::Button::Confirm}, [&] {
+    if (over || (won && !acknowledgedWin)) {
+      if (over) {
+        reset();
+      } else {
+        acknowledgedWin = true;  // dismiss the win banner and keep playing
+      }
+      dirty = true;
+    }
+  });
+  ButtonNavigator::onPress({MappedInputManager::Button::Back}, [&] { finish(); });
+
+  if (dirty) requestUpdate();
+}
+
+void Game2048Activity::renderTile(const int x, const int y, const int size, const uint16_t value) const {
+  const Color shade = tileShade(value);
+  if (shade == Clear) {
+    renderer.drawRect(x, y, size, size, value == 0 ? 1 : 2, true);
+  } else {
+    renderer.fillRectDither(x, y, size, size, shade);
+    renderer.drawRect(x, y, size, size, 2, true);
+  }
+  if (value == 0) return;
+
+  char buf[8];
+  snprintf(buf, sizeof(buf), "%u", value);
+  const int fontId = digitFont(value);
+  // A dark tile needs a light number, so knock a white box behind the digits.
+  const bool darkTile = shade == DarkGray;
+  const int textW = renderer.getTextWidth(fontId, buf);
+  const int textH = renderer.getTextHeight(fontId);
+  const int tx = x + (size - textW) / 2;
+  const int ty = y + (size - textH) / 2;
+  if (darkTile) renderer.fillRect(tx - 4, ty - 2, textW + 8, textH + 4, false);
+  renderer.drawText(fontId, tx, ty, buf, true);
+}
+
+void Game2048Activity::render(RenderLock&&) {
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const Rect safe = UITheme::getInstance().getScreenSafeArea(renderer, true, false);
+
+  renderer.clearScreen();
+  GUI.drawHeader(renderer, Rect{safe.x, safe.y + metrics.topPadding, safe.width, metrics.headerHeight}, "2048");
+
+  const int lineH = renderer.getLineHeight(UI_12_FONT_ID);
+  int y = safe.y + metrics.topPadding + metrics.headerHeight + 6;
+  char scoreLine[48];
+  snprintf(scoreLine, sizeof(scoreLine), "%s: %u    %s: %u", tr(STR_G2048_SCORE), score, tr(STR_G2048_BEST), best);
+  renderer.drawCenteredText(UI_12_FONT_ID, y, scoreLine);
+  y += lineH + BOARD_MARGIN;
+
+  const int bottomText = 2 * lineH + BOARD_MARGIN;
+  const int availH = safe.y + safe.height - y - bottomText;
+  const int availW = safe.width - 2 * BOARD_MARGIN;
+  int boardPx = availW < availH ? availW : availH;
+  const int tile = (boardPx - (N + 1) * TILE_GAP) / N;
+  boardPx = N * tile + (N + 1) * TILE_GAP;
+  const int boardX = safe.x + (safe.width - boardPx) / 2;
+  const int boardY = y;
+
+  renderer.fillRectDither(boardX, boardY, boardPx, boardPx, LightGray);
+  renderer.drawRect(boardX, boardY, boardPx, boardPx, 2, true);
+  for (int r = 0; r < N; r++) {
+    for (int c = 0; c < N; c++) {
+      const int tx = boardX + TILE_GAP + c * (tile + TILE_GAP);
+      const int ty = boardY + TILE_GAP + r * (tile + TILE_GAP);
+      renderTile(tx, ty, tile, tiles[r * N + c]);
+    }
+  }
+
+  const int msgY = boardY + boardPx + BOARD_MARGIN;
+  if (over) {
+    renderer.drawCenteredText(UI_12_FONT_ID, msgY, tr(STR_G2048_OVER));
+  } else if (won && !acknowledgedWin) {
+    renderer.drawCenteredText(UI_12_FONT_ID, msgY, tr(STR_G2048_WIN));
+  } else {
+    renderer.drawCenteredText(UI_10_FONT_ID, msgY, tr(STR_G2048_HELP));
+  }
+
+  const char* confirmLabel = over ? tr(STR_CHESS_NEW_GAME) : (won && !acknowledgedWin ? tr(STR_CHESS_NEXT) : "");
+  const auto hints = mappedInput.mapLabels(tr(STR_BACK), confirmLabel, "", "");
+  GUI.drawButtonHints(renderer, hints.btn1, hints.btn2, hints.btn3, hints.btn4);
+  renderer.displayBuffer();
+}
diff --git a/src/activities/util/Game2048Activity.h b/src/activities/util/Game2048Activity.h
