+
+void Board::reset() { setFen("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"); }
+
+bool Board::setFen(const char* fen) {
+  for (int i = 0; i < 64; i++) sq[i] = EMPTY;
+  whiteToMove = true;
+  castling = 0;
+  epSquare = -1;
+  halfmove = 0;
+  if (!fen) return false;
+
+  int f = 0, r = 7;
+  const char* p = fen;
+  for (; *p && *p != ' '; p++) {
+    const char c = *p;
+    if (c == '/') {
+      f = 0;
+      r--;
+      continue;
+    }
+    if (c >= '1' && c <= '8') {
+      f += c - '0';
+      continue;
+    }
+    int8_t piece = EMPTY;
+    switch (c | 0x20) {
+      case 'p':
+        piece = PAWN;
+        break;
+      case 'n':
+        piece = KNIGHT;
+        break;
+      case 'b':
+        piece = BISHOP;
+        break;
+      case 'r':
+        piece = ROOK;
+        break;
+      case 'q':
+        piece = QUEEN;
+        break;
+      case 'k':
+        piece = KING;
+        break;
+      default:
+        return false;
+    }
+    if (!onBoard(f, r)) return false;
+    sq[r * 8 + f] = (c >= 'a') ? static_cast<int8_t>(-piece) : piece;
+    f++;
+  }
+  if (*p == ' ') p++;
+  if (*p == 'b') whiteToMove = false;
+  while (*p && *p != ' ') p++;
+  if (*p == ' ') p++;
+  for (; *p && *p != ' '; p++) {
+    if (*p == 'K') castling |= WHITE_KINGSIDE;
+    if (*p == 'Q') castling |= WHITE_QUEENSIDE;
+    if (*p == 'k') castling |= BLACK_KINGSIDE;
+    if (*p == 'q') castling |= BLACK_QUEENSIDE;
+  }
+  if (*p == ' ') p++;
+  if (p[0] >= 'a' && p[0] <= 'h' && p[1] >= '1' && p[1] <= '8') {
+    epSquare = static_cast<int8_t>((p[1] - '1') * 8 + (p[0] - 'a'));
+  }
+  return kingSquare(true) >= 0 && kingSquare(false) >= 0;
+}
+
+int Board::kingSquare(const bool white) const {
+  const int8_t target = white ? KING : static_cast<int8_t>(-KING);
+  for (int i = 0; i < 64; i++) {
+    if (sq[i] == target) return i;
+  }
+  return -1;
+}
+
+bool Board::isAttacked(const int square, const bool byWhite) const {
+  if (square < 0) return false;
+  const int f = fileOf(square), r = rankOf(square);
+  const int sign = byWhite ? 1 : -1;
+
+  // A white pawn attacks diagonally upward, so it sits one rank below its target.
+  const int pr = r - sign;
+  if (pr >= 0 && pr < 8) {
+    if (f > 0 && sq[pr * 8 + f - 1] == sign * PAWN) return true;
+    if (f < 7 && sq[pr * 8 + f + 1] == sign * PAWN) return true;
+  }
+  for (int i = 0; i < 8; i++) {
+    const int nf = f + KNIGHT_DF[i], nr = r + KNIGHT_DR[i];
+    if (onBoard(nf, nr) && sq[nr * 8 + nf] == sign * KNIGHT) return true;
+    const int kf = f + KING_DF[i], kr = r + KING_DR[i];
+    if (onBoard(kf, kr) && sq[kr * 8 + kf] == sign * KING) return true;
+  }
+  for (int d = 0; d < 8; d++) {
+    const int8_t slider = d < 4 ? ROOK : BISHOP;
+    int cf = f + RAY_DF[d], cr = r + RAY_DR[d];
+    while (onBoard(cf, cr)) {
+      const int8_t p = sq[cr * 8 + cf];
+      if (p != EMPTY) {
+        if (p == sign * slider || p == sign * QUEEN) return true;
+        break;
+      }
+      cf += RAY_DF[d];
+      cr += RAY_DR[d];
+    }
+  }
+  return false;
+}
+
+int Board::generatePseudo(Move* out, const bool capturesOnly) const {
+  int n = 0;
+  const int sign = whiteToMove ? 1 : -1;
+
+  for (int s = 0; s < 64; s++) {
+    const int8_t p = sq[s];
+    if (p == EMPTY || (p > 0) != whiteToMove) continue;
+    const int f = fileOf(s), r = rankOf(s);
+
+    switch (absPiece(p)) {
+      case PAWN: {
+        const int nr = r + sign;
+        if (nr < 0 || nr > 7) break;
+        if (!capturesOnly && sq[nr * 8 + f] == EMPTY) {
+          pushPawnMove(out, n, s, nr * 8 + f, F_NONE);
+          const int startRank = whiteToMove ? 1 : 6;
+          if (r == startRank && sq[(nr + sign) * 8 + f] == EMPTY) {
+            push(out, n, s, (nr + sign) * 8 + f, F_DOUBLE_PUSH);
+          }
+        }
+        for (int df = -1; df <= 1; df += 2) {
+          const int nf = f + df;
+          if (nf < 0 || nf > 7) continue;
+          const int to = nr * 8 + nf;
+          const int8_t target = sq[to];
+          if (target != EMPTY && (target > 0) != whiteToMove) {
+            pushPawnMove(out, n, s, to, F_CAPTURE);
+          } else if (to == epSquare && target == EMPTY) {
+            push(out, n, s, to, F_CAPTURE | F_EN_PASSANT);
+          }
+        }
+        break;
+      }
+      case KNIGHT:
+      case KING: {
+        const int8_t* df = absPiece(p) == KNIGHT ? KNIGHT_DF : KING_DF;
+        const int8_t* dr = absPiece(p) == KNIGHT ? KNIGHT_DR : KING_DR;
+        for (int i = 0; i < 8; i++) {
+          const int nf = f + df[i], nr = r + dr[i];
+          if (!onBoard(nf, nr)) continue;
+          const int8_t target = sq[nr * 8 + nf];
+          if (target == EMPTY) {
+            if (!capturesOnly) push(out, n, s, nr * 8 + nf, F_NONE);
+          } else if ((target > 0) != whiteToMove) {
+            push(out, n, s, nr * 8 + nf, F_CAPTURE);
+          }
+        }
+        break;
+      }
+      default: {
+        const int first = absPiece(p) == BISHOP ? 4 : 0;
+        const int last = absPiece(p) == ROOK ? 4 : 8;
+        for (int d = first; d < last; d++) {
+          int cf = f + RAY_DF[d], cr = r + RAY_DR[d];
+          while (onBoard(cf, cr)) {
+            const int8_t target = sq[cr * 8 + cf];
+            if (target == EMPTY) {
+              if (!capturesOnly) push(out, n, s, cr * 8 + cf, F_NONE);
+            } else {
+              if ((target > 0) != whiteToMove) push(out, n, s, cr * 8 + cf, F_CAPTURE);
+              break;
+            }
+            cf += RAY_DF[d];
+            cr += RAY_DR[d];
+          }
+        }
+        break;
+      }
+    }
+  }
+
+  if (capturesOnly) return n;
+
+  // Castling: the king may not start in, pass through, or land on an attacked square.
+  const int home = whiteToMove ? 4 : 60;
+  if (sq[home] != sign * KING) return n;
+  const uint8_t kingside = whiteToMove ? WHITE_KINGSIDE : BLACK_KINGSIDE;
+  const uint8_t queenside = whiteToMove ? WHITE_QUEENSIDE : BLACK_QUEENSIDE;
+  const bool enemy = !whiteToMove;
+  if ((castling & kingside) && sq[home + 1] == EMPTY && sq[home + 2] == EMPTY && sq[home + 3] == sign * ROOK &&
+      !isAttacked(home, enemy) && !isAttacked(home + 1, enemy) && !isAttacked(home + 2, enemy)) {
+    push(out, n, home, home + 2, F_CASTLE);
+  }
+  if ((castling & queenside) && sq[home - 1] == EMPTY && sq[home - 2] == EMPTY && sq[home - 3] == EMPTY &&
+      sq[home - 4] == sign * ROOK && !isAttacked(home, enemy) && !isAttacked(home - 1, enemy) &&
+      !isAttacked(home - 2, enemy)) {
+    push(out, n, home, home - 2, F_CASTLE);
+  }
+  return n;
+}
+
+void Board::make(const Move& m, Undo& u) {
+  u.captured = sq[m.to];
+  u.castling = castling;
+  u.epSquare = epSquare;
+  u.halfmove = halfmove;
+
+  const int8_t piece = sq[m.from];
+  const int sign = piece > 0 ? 1 : -1;
+
+  halfmove = (absPiece(piece) == PAWN || (m.flags & F_CAPTURE)) ? 0 : static_cast<uint8_t>(halfmove + 1);
+
+  sq[m.to] = m.promo ? static_cast<int8_t>(sign * m.promo) : piece;
+  sq[m.from] = EMPTY;
+
+  if (m.flags & F_EN_PASSANT) sq[m.to - sign * 8] = EMPTY;
+  if (m.flags & F_CASTLE) {
+    if (m.to > m.from) {
+      sq[m.from + 1] = sq[m.from + 3];
+      sq[m.from + 3] = EMPTY;
+    } else {
+      sq[m.from - 1] = sq[m.from - 4];
+      sq[m.from - 4] = EMPTY;
+    }
+  }
+
+  epSquare = (m.flags & F_DOUBLE_PUSH) ? static_cast<int8_t>(m.from + sign * 8) : static_cast<int8_t>(-1);
+
+  // Any move that starts or ends on a king or rook home square ends that right.
+  auto clear = [&](int s) {
+    switch (s) {
+      case 4:
+        castling &= static_cast<uint8_t>(~(WHITE_KINGSIDE | WHITE_QUEENSIDE));
+        break;
+      case 0:
+        castling &= static_cast<uint8_t>(~WHITE_QUEENSIDE);
+        break;
+      case 7:
+        castling &= static_cast<uint8_t>(~WHITE_KINGSIDE);
+        break;
+      case 60:
+        castling &= static_cast<uint8_t>(~(BLACK_KINGSIDE | BLACK_QUEENSIDE));
+        break;
+      case 56:
+        castling &= static_cast<uint8_t>(~BLACK_QUEENSIDE);
+        break;
+      case 63:
+        castling &= static_cast<uint8_t>(~BLACK_KINGSIDE);
+        break;
+      default:
+        break;
+    }
+  };
+  clear(m.from);
+  clear(m.to);
+
+  whiteToMove = !whiteToMove;
+}
+
+void Board::unmake(const Move& m, const Undo& u) {
+  whiteToMove = !whiteToMove;
+  const int sign = whiteToMove ? 1 : -1;
+
+  sq[m.from] = m.promo ? static_cast<int8_t>(sign * PAWN) : sq[m.to];
+  sq[m.to] = u.captured;
+
+  if (m.flags & F_EN_PASSANT) sq[m.to - sign * 8] = static_cast<int8_t>(-sign * PAWN);
+  if (m.flags & F_CASTLE) {
+    if (m.to > m.from) {
+      sq[m.from + 3] = sq[m.from + 1];
+      sq[m.from + 1] = EMPTY;
+    } else {
+      sq[m.from - 4] = sq[m.from - 1];
+      sq[m.from - 1] = EMPTY;
+    }
+  }
+  castling = u.castling;
+  epSquare = u.epSquare;
+  halfmove = u.halfmove;
+}
+
+int Board::generateLegal(Move* out) {
+  // Filter in place: `out` already holds MAX_MOVES entries, so no second buffer.
+  const int n = generatePseudo(out, false);
+  const bool mover = whiteToMove;
+  int legal = 0;
+  for (int i = 0; i < n; i++) {
+    const Move m = out[i];
+    Undo u;
+    make(m, u);
+    const bool ok = !isAttacked(kingSquare(mover), !mover);
+    unmake(m, u);
+    if (ok) out[legal++] = m;
+  }
+  return legal;
+}
+
+bool Board::hasLegalMove(Move* scratch) {
+  const int n = generatePseudo(scratch, false);
+  const bool mover = whiteToMove;
+  for (int i = 0; i < n; i++) {
+    Undo u;
+    make(scratch[i], u);
+    const bool ok = !isAttacked(kingSquare(mover), !mover);
+    unmake(scratch[i], u);
+    if (ok) return true;
+  }
+  return false;
+}
+
+uint64_t Board::perft(const int depth, Move* pool, const int poolSize) {
+  if (depth == 0) return 1;
+  if (poolSize < MAX_MOVES) return 0;
+  const int n = generatePseudo(pool, false);
+  const bool mover = whiteToMove;
+  uint64_t total = 0;
+  for (int i = 0; i < n; i++) {
+    Undo u;
+    make(pool[i], u);
+    if (!isAttacked(kingSquare(mover), !mover)) total += perft(depth - 1, pool + n, poolSize - n);
+    unmake(pool[i], u);
+  }
+  return total;
+}
+
+bool insufficientMaterial(const Board& board) {
+  int minors = 0;
+  for (int s = 0; s < 64; s++) {
+    switch (absPiece(board.sq[s])) {
+      case EMPTY:
+      case KING:
+        break;
+      case KNIGHT:
+      case BISHOP:
+        if (++minors > 1) return false;
+        break;
+      default:
+        return false;  // any pawn, rook or queen can still mate
+    }
+  }
+  return true;
+}
+
+uint64_t positionKey(const Board& board) {
+  uint64_t h = 1469598103934665603ull;  // FNV-1a
+  auto mix = [&](uint8_t v) {
+    h ^= v;
+    h *= 1099511628211ull;
+  };
+  for (int s = 0; s < 64; s++) mix(static_cast<uint8_t>(board.sq[s] + 8));
+  mix(board.whiteToMove ? 1 : 0);
+  mix(board.castling);
+  mix(static_cast<uint8_t>(board.epSquare + 1));
+  return h;
+}
