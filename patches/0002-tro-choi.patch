+namespace {
+
+constexpr int fileOf(int s) { return s & 7; }
+constexpr int rankOf(int s) { return s >> 3; }
+constexpr bool onBoard(int f, int r) { return f >= 0 && f < 8 && r >= 0 && r < 8; }
+constexpr int absPiece(int8_t p) { return p < 0 ? -p : p; }
+
+constexpr int8_t KNIGHT_DF[8] = {1, 2, 2, 1, -1, -2, -2, -1};
+constexpr int8_t KNIGHT_DR[8] = {2, 1, -1, -2, -2, -1, 1, 2};
+constexpr int8_t KING_DF[8] = {1, 1, 1, 0, 0, -1, -1, -1};
+constexpr int8_t KING_DR[8] = {1, 0, -1, 1, -1, 1, 0, -1};
+// First four entries are the rook rays, last four the bishop rays.
+constexpr int8_t RAY_DF[8] = {1, -1, 0, 0, 1, 1, -1, -1};
+constexpr int8_t RAY_DR[8] = {0, 0, 1, -1, 1, -1, 1, -1};
+
+constexpr int PIECE_VALUE[7] = {0, 100, 320, 330, 500, 900, 0};
+constexpr int MATE_SCORE = 30000;
+constexpr int QUIESCENCE_PLIES = 4;
+
+void push(Move* out, int& n, int from, int to, uint8_t flags, uint8_t promo = EMPTY) {
+  if (n >= MAX_MOVES) return;
+  out[n].from = static_cast<uint8_t>(from);
+  out[n].to = static_cast<uint8_t>(to);
+  out[n].promo = promo;
+  out[n].flags = flags;
+  n++;
+}
+
+void pushPawnMove(Move* out, int& n, int from, int to, uint8_t flags) {
+  const int r = rankOf(to);
+  if (r == 7 || r == 0) {
+    push(out, n, from, to, flags, QUEEN);
+    push(out, n, from, to, flags, ROOK);
+    push(out, n, from, to, flags, BISHOP);
+    push(out, n, from, to, flags, KNIGHT);
+  } else {
+    push(out, n, from, to, flags);
+  }
+}
+
